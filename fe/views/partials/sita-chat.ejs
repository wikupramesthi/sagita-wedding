<div id="sitaChatWidget" class="sita-chat" data-locale="<%= lang === 'en' ? 'en' : 'id' %>" data-whatsapp-link="<%= contactLinks.whatsappShortLink %>">
  <section id="sitaChatPanel" class="sita-chat-panel hidden" role="dialog" aria-modal="false" aria-labelledby="sitaChatTitle">
    <header class="sita-chat-header">
      <div class="sita-chat-avatar" aria-hidden="true">
        <svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg">
          <path d="M24 4v6" />
          <circle cx="24" cy="4" r="2" />
          <rect x="8" y="11" width="32" height="27" rx="9" />
          <path d="M8 21H4v9h4m32-9h4v9h-4M17 38v5m14-5v5" />
          <circle cx="18" cy="24" r="2" class="sita-robot-eye" />
          <circle cx="30" cy="24" r="2" class="sita-robot-eye" />
          <path d="M19 31h10" />
        </svg>
      </div>
      <div class="sita-chat-heading">
        <h2 id="sitaChatTitle">Sita</h2>
        <p class="sita-chat-status">
          <span class="sita-chat-status__dot" aria-hidden="true"></span>
          <%= lang === 'en' ? 'Sagita Wedding virtual assistant · online 24 hours' : 'Asisten virtual Sagita Wedding · online 24 jam' %>
        </p>
      </div>
      <button id="sitaChatReset" class="sita-chat-reset" type="button" aria-label="<%= lang === 'en' ? 'Reset chat and criteria' : 'Reset chat dan kriteria' %>"><%= lang === 'en' ? 'Reset' : 'Reset' %></button>
      <button id="sitaChatClose" class="sita-chat-close" type="button" aria-label="<%= lang === 'en' ? 'Close chat' : 'Tutup chat' %>">
        <svg viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path d="m18 6-12 12M6 6l12 12" /></svg>
      </button>
    </header>

    <div id="sitaChatMessages" class="sita-chat-messages" role="log" aria-live="polite" aria-relevant="additions text">
      <article class="sita-chat-message">
        <span class="sita-chat-message__sender sr-only">Sita</span>
        <p class="sita-chat-message__text"><%= lang === 'en' ? 'Hi! I’m Sita, Sagita Wedding’s virtual assistant. Ask me about packages, venues, services, vendors, or booking.' : 'Halo Kak! Aku Sita, asisten virtual Sagita Wedding. Tanya seputar paket, venue, layanan, vendor, atau cara booking, ya.' %></p>
      </article>
    </div>
    <div id="sitaChatOnboarding" class="sita-chat-onboarding" role="group" aria-label="<%= lang === 'en' ? 'Example questions' : 'Contoh pertanyaan' %>">
      <p><%= lang === 'en' ? 'Try asking:' : 'Coba tanya:' %></p>
      <button type="button" data-sita-example="<%= lang === 'en' ? 'What are the package prices?' : 'Paket pernikahan berapa harganya?' %>"><%= lang === 'en' ? 'Package prices' : 'Harga paket' %></button>
      <button type="button" data-sita-example="<%= lang === 'en' ? 'Which venues are available?' : 'Venue apa yang tersedia?' %>"><%= lang === 'en' ? 'Available venues' : 'Venue tersedia' %></button>
      <button type="button" data-sita-example="<%= lang === 'en' ? 'How do I book?' : 'Bagaimana cara booking?' %>"><%= lang === 'en' ? 'How to book' : 'Cara booking' %></button>
    </div>
    <div id="sitaChatChoices" class="sita-chat-choices" role="group" aria-label="<%= lang === 'en' ? 'Choose a topic' : 'Pilih topik' %>">
      <button type="button" data-sita-topic="packages"><%= lang === 'en' ? 'Packages & pricing' : 'Paket & harga' %></button>
      <button type="button" data-sita-topic="venues"><%= lang === 'en' ? 'Wedding venues' : 'Venue' %></button>
      <button type="button" data-sita-topic="services"><%= lang === 'en' ? 'Wedding services' : 'Layanan WO' %></button>
      <button type="button" data-sita-topic="vendors"><%= lang === 'en' ? 'Vendors' : 'Vendor' %></button>
      <button type="button" data-sita-topic="booking"><%= lang === 'en' ? 'Booking process' : 'Cara booking' %></button>
      <button type="button" data-sita-topic="contact"><%= lang === 'en' ? 'Contact the team' : 'Hubungi admin' %></button>
    </div>
    <form id="sitaChatLead" class="sita-chat-lead hidden">
      <strong><%= lang === 'en' ? 'Ask the Sagita team' : 'Minta dibantu admin Sagita' %></strong>
      <label for="sitaChatName"><%= lang === 'en' ? 'Your name' : 'Nama kamu' %></label>
      <input id="sitaChatName" name="name" type="text" maxlength="80" autocomplete="name" required>
      <label for="sitaChatPhone"><%= lang === 'en' ? 'WhatsApp number' : 'Nomor WhatsApp' %></label>
      <input id="sitaChatPhone" name="phone" type="tel" inputmode="tel" maxlength="20" autocomplete="tel" pattern="[0-9+() -]{6,20}" required>
      <label class="sita-chat-consent">
        <input name="consent" type="checkbox" required>
        <span><%= lang === 'en' ? 'I agree to open WhatsApp and contact the Sagita team.' : 'Saya setuju membuka WhatsApp untuk menghubungi admin Sagita.' %></span>
      </label>
      <input name="website" type="text" tabindex="-1" autocomplete="off" hidden>
      <button type="submit"><%= lang === 'en' ? 'Continue to WhatsApp' : 'Lanjut ke WhatsApp' %></button>
      <button class="sita-chat-skip" type="button" data-sita-skip><%= lang === 'en' ? 'Skip for now' : 'Lewati dulu' %></button>
    </form>
    <form id="sitaChatComposer" class="sita-chat-composer">
      <label class="sr-only" for="sitaChatInput"><%= lang === 'en' ? 'Write a question' : 'Tulis pertanyaan' %></label>
      <input id="sitaChatInput" type="text" maxlength="500" autocomplete="off" placeholder="<%= lang === 'en' ? 'Write a question…' : 'Tulis pertanyaan…' %>" required>
      <button type="submit" aria-label="<%= lang === 'en' ? 'Send message' : 'Kirim pesan' %>"><%= lang === 'en' ? 'Send' : 'Kirim' %></button>
    </form>
    <p class="sita-chat-note">
      <%= lang === 'en' ? 'Sita is Sagita Wedding’s virtual assistant. Unanswered questions can be sent to the team.' : 'Sita adalah asisten virtual Sagita Wedding. Pertanyaan yang belum terjawab bisa diteruskan ke admin.' %>
      <a href="/pages/kebijakan-privasi"><%= lang === 'en' ? 'Privacy Policy' : 'Kebijakan Privasi' %></a>
    </p>
  </section>

  <button id="sitaChatToggle" class="sita-chat-toggle" type="button" aria-label="<%= lang === 'en' ? 'Open chat with Sita' : 'Buka chat dengan Sita' %>" aria-expanded="false" aria-controls="sitaChatPanel">
    <svg class="sita-robot" viewBox="0 0 48 48" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
      <path d="M24 5v6" />
      <circle cx="24" cy="4" r="2" class="sita-robot-signal" />
      <rect x="8" y="12" width="32" height="27" rx="9" />
      <path d="M8 22H4v9h4m32-9h4v9h-4M17 39v5m14-5v5" />
      <circle cx="18" cy="25" r="2" class="sita-robot-eye" />
      <circle cx="30" cy="25" r="2" class="sita-robot-eye" />
      <path d="M19 32h10" />
    </svg>
    <span>Sita</span>
  </button>
</div>
