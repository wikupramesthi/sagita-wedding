<footer class="bg-sand-900 text-sand-300 relative overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" style="opacity:0.055; background-image:url(&quot;data:image/svg+xml,%3Csvg width='36' height='36' viewBox='0 0 36 36' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M-10 46 46 -10' stroke='%23ffffff' stroke-width='1' fill='none'/%3E%3C/svg%3E&quot;)"></div>

  <div class="relative mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="grid grid-cols-1 items-start gap-y-10 sm:grid-cols-2 sm:gap-x-10 lg:grid-cols-3 lg:gap-x-8">

      <!-- Brand (dinamis dari Identitas Website) -->
      <div class="min-w-0">
        <div class="mb-4">
          <img src="<%= site.logoUrl || site.logoWhiteUrl || "/img/logo.WebP" %>" alt="<%= site.name %>" width="160" height="40" class="footer-logo object-contain" loading="lazy" decoding="async">
        </div>
        <p class="break-words text-sm leading-relaxed text-sand-400"><%= site.tagline %><%= site.description ? ` — ${site.description}` : "" %></p>
        <% if (site.instagramHref || site.facebookHref || site.youtubeHref || site.tiktokHref) { %>
        <div class="mt-5 flex flex-wrap items-center gap-2.5">
          <% if (site.instagramHref) { %>
          <a href="<%= site.instagramHref %>" target="_blank" rel="noopener noreferrer" aria-label="<%= site.name %> on Instagram" class="grid h-9 w-9 place-items-center rounded-full border border-sand-700 text-sand-400 transition-colors hover:border-sand-500 hover:text-sand-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
          </a>
          <% } %>
          <% if (site.facebookHref) { %>
          <a href="<%= site.facebookHref %>" target="_blank" rel="noopener noreferrer" aria-label="<%= site.name %> on Facebook" class="grid h-9 w-9 place-items-center rounded-full border border-sand-700 text-sand-400 transition-colors hover:border-sand-500 hover:text-sand-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
          </a>
          <% } %>
          <% if (site.youtubeHref) { %>
          <a href="<%= site.youtubeHref %>" target="_blank" rel="noopener noreferrer" aria-label="<%= site.name %> on YouTube" class="grid h-9 w-9 place-items-center rounded-full border border-sand-700 text-sand-400 transition-colors hover:border-sand-500 hover:text-sand-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path><path d="m10 15 5-3-5-3z"></path></svg>
          </a>
          <% } %>
          <% if (site.tiktokHref) { %>
          <a href="<%= site.tiktokHref %>" target="_blank" rel="noopener noreferrer" aria-label="<%= site.name %> on TikTok" class="grid h-9 w-9 place-items-center rounded-full border border-sand-700 text-sand-400 transition-colors hover:border-sand-500 hover:text-sand-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg>
          </a>
          <% } %>
        </div>
        <% } %>
      </div>

      <!-- Explore -->
      <nav aria-label="<%= t.footerExplore %>" class="min-w-0">
        <h4 class="mb-4 font-sans text-xs uppercase tracking-[0.15em] text-sand-500"><%= t.footerExplore %></h4>
        <div class="flex flex-col gap-2.5">
          <a href="/about" class="text-sm leading-6 transition-colors hover:text-sand-100"><%= (t.nav && t.nav.about) || 'About' %></a>
          <a href="/venues" class="text-sm leading-6 transition-colors hover:text-sand-100"><%= (t.nav && t.nav.venues) || 'Venues' %></a>
          <a href="/portofolio" class="text-sm leading-6 transition-colors hover:text-sand-100"><%= (t.nav && t.nav.portfolio) || 'Portfolio' %></a>
          <a href="/vendors" class="text-sm leading-6 transition-colors hover:text-sand-100"><%= t.footerVendors %></a>
          <a href="/packages" class="text-sm leading-6 transition-colors hover:text-sand-100"><%= t.footerPackages %></a>
          <a href="/faq" class="text-sm leading-6 transition-colors hover:text-sand-100"><%= t.footerFAQs %></a>
        </div>
      </nav>

      <!-- Get in Touch -->
      <address class="not-italic min-w-0">
        <h4 class="mb-4 font-sans text-xs uppercase tracking-[0.15em] text-sand-500"><%= t.footerGetInTouch %></h4>
        <div class="flex flex-col gap-3">
          <% if (site.address) { %>
          <span class="flex items-start gap-2.5 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 flex-shrink-0 text-sand-500"><path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path><circle cx="12" cy="10" r="3"></circle></svg>
            <span class="min-w-0 break-words"><%= site.address %></span>
          </span>
          <% } %>
          <a href="tel:<%= site.phoneTel %>" class="flex items-start gap-2.5 text-sm transition-colors hover:text-sand-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 flex-shrink-0 text-sand-500"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            <span class="min-w-0 break-all"><%= site.phone %></span>
          </a>
          <% if (site.email) { %>
          <a href="mailto:<%= site.email %>" class="flex items-start gap-2.5 text-sm transition-colors hover:text-sand-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 flex-shrink-0 text-sand-500"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            <span class="min-w-0 break-all"><%= site.email %></span>
          </a>
          <% } %>
          <% if (site.instagramHref && site.instagramHandle) { %>
          <a href="<%= site.instagramHref %>" target="_blank" rel="noopener noreferrer" class="flex items-start gap-2.5 text-sm transition-colors hover:text-sand-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 h-4 w-4 flex-shrink-0 text-sand-500"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line></svg>
            <span class="min-w-0 break-all">@<%= site.instagramHandle %></span>
          </a>
          <% } %>
        </div>
      </address>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-sand-800 pt-7 text-center text-xs text-sand-600 sm:flex-row sm:items-center sm:justify-between sm:text-left">
      <p class="leading-relaxed"><span>© <%= site.year %> <%= site.name %>.</span> <span><%= t.copyright %></span></p>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 sm:justify-end">
        <a href="/pages/kebijakan-privasi" class="transition-colors hover:text-sand-100"><%= t.privacyPolicy %></a>
        <a href="/pages/syarat-ketentuan" class="transition-colors hover:text-sand-100"><%= t.termsConditions %></a>
      </div>
    </div>
  </div>
</footer>

<%- include('./whatsapp-float') %>
<%- include('./accessibility-widget') %>
<%- include('./booking-modal') %>
<script src="/js/main.js?v=<%= assetV %>" defer></script>
<script src="/js/accessibility.js?v=<%= assetV %>-a11y1" defer></script>
<% if (typeof pageScript !== 'undefined' && pageScript) { %><script nonce="<%= nonce %>">import("/js/pages/<%= pageScript %>.js?v=<%= assetV %>");</script><% } %>