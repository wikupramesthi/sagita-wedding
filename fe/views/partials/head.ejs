<% /* ============================================================
   SEO <head> — standar Google (dinamis dari API identitas website)
   - title & description unik per halaman (boleh override via render)
   - canonical absolut, robots, hreflang (multibahasa ?lang=)
   - Open Graph + Twitter Card absolut, favicon dinamis
   - JSON-LD Organization & WebSite, GA4 & site-verification opsional
   ============================================================ */ %>
<%
const _site = typeof site !== "undefined" && site ? site : {};
const _seo = typeof seo !== "undefined" && seo ? seo : {};
const _siteUrl = typeof siteUrl !== "undefined" ? siteUrl : "";
const _pageTitle = typeof title !== "undefined" && title ? title : ((_site.metaTitle || _site.name || "Sagita Wedding") + " — " + (_site.tagline || "Wedding Planner"));
const _description = (typeof metaDescription !== "undefined" && metaDescription ? metaDescription : (_seo.description || _site.metaDescription || _site.description || t.siteDesc)).toString().slice(0, 160);
const _keywords = typeof metaKeywords !== "undefined" && metaKeywords ? metaKeywords : (_seo.keywords || _site.metaKeywords || "");
const _robots = typeof robots !== "undefined" && robots ? robots : (_seo.robots || "index, follow");
const _canonical = typeof currentUrl !== "undefined" ? currentUrl : _siteUrl;
const _currentPath = typeof currentPath !== "undefined" ? currentPath : "/";
const _languageUrl = (code) => `${_siteUrl}${_currentPath}${code === "en" ? "" : `?lang=${encodeURIComponent(code)}`}`;
const _absoluteUrl = (value) => {
  const text = String(value || "").trim();
  if (!text) return `${_siteUrl}/img/logo.WebP`;
  if (/^https?:\/\//i.test(text)) return text;
  return _siteUrl + (text.startsWith("/") ? text : `/${text}`);
};
const _ogImageRaw = typeof ogImage !== "undefined" && ogImage
  ? ogImage
  : (_seo.ogImage || _site.ogImage || "/img/logo.WebP");
const _ogImage = _absoluteUrl(_ogImageRaw);
const _ogType = typeof ogType !== "undefined" && ogType ? ogType : "website";
const _articleMeta = typeof articleMeta !== "undefined" && articleMeta ? articleMeta : null;
const _faviconRaw = _site.faviconUrl || "/img/fav.png";
const _favicon = /^https?:\/\//i.test(_faviconRaw) ? _faviconRaw : (_siteUrl + _faviconRaw);
const _lang = typeof lang !== "undefined" && lang ? lang : "en";
const _langCodes = typeof languages !== "undefined" ? languages.map((item) => item.code) : ["en"];
const _jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": _siteUrl + "/#organization",
      "name": _site.name || "Sagita Wedding",
      "url": _siteUrl,
      "slogan": _site.tagline || "",
      "description": _site.description || t.siteDesc,
      "logo": /^https?:\/\//i.test(_site.logoUrl || "") ? _site.logoUrl : (_siteUrl + (_site.logoUrl || "/img/logo.WebP")),
      "image": _ogImage,
      "email": _site.email || undefined,
      "telephone": _site.phoneTel || undefined,
      "address": _site.address ? { "@type": "PostalAddress", "streetAddress": _site.address } : undefined,
      "sameAs": [_site.facebookHref, _site.instagramHref, _site.youtubeHref, _site.tiktokHref].filter(Boolean)
    },
    {
      "@type": "WebSite",
      "@id": _siteUrl + "/#website",
      "url": _siteUrl,
      "name": _site.name || "Sagita Wedding",
      "inLanguage": _langCodes,
      "publisher": { "@id": _siteUrl + "/#organization" }
    },
    {
      "@type": typeof pageSchemaType !== "undefined" ? pageSchemaType : "WebPage",
      "@id": _canonical + "#webpage",
      "url": _canonical,
      "name": _pageTitle,
      "description": _description,
      "inLanguage": _lang,
      "isPartOf": { "@id": _siteUrl + "/#website" }
    }
  ]
};
if (_articleMeta || _ogType === "article") {
  _jsonLd["@graph"].push({
    "@type": "BlogPosting",
    "@id": _canonical + "#article",
    "url": _canonical,
    "headline": (_articleMeta && _articleMeta.headline) || _pageTitle,
    "description": (_articleMeta && _articleMeta.description) || _description,
    "image": _articleMeta && _articleMeta.image ? _absoluteUrl(_articleMeta.image) : _ogImage,
    "datePublished": _articleMeta && _articleMeta.datePublished ? _articleMeta.datePublished : undefined,
    "dateModified": _articleMeta && _articleMeta.dateModified ? _articleMeta.dateModified : undefined,
    "articleSection": _articleMeta && _articleMeta.section ? _articleMeta.section : undefined,
    "author": { "@type": "Organization", "name": _site.name || "Sagita Wedding" },
    "publisher": { "@id": _siteUrl + "/#organization" },
    "mainEntityOfPage": { "@id": _canonical + "#webpage" },
    "inLanguage": _lang
  });
}
%>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title><%= _pageTitle %></title>
<meta name="description" content="<%= _description %>" />
<% if (_keywords) { %>
<meta name="keywords" content="<%= _keywords %>" />
<% } %>
<meta name="robots" content="<%= _robots %>" />
<meta name="author" content="<%= _site.name || "Sagita Wedding" %>" />
<meta name="theme-color" content="#fffefd" />

<link rel="canonical" href="<%= _canonical %>" />

<!-- Hreflang: setiap bahasa memiliki URL stabil dan canonical yang sesuai -->
<link rel="alternate" hreflang="x-default" href="<%= _languageUrl('en') %>" />
<% _langCodes.forEach((code) => { %>
<link rel="alternate" hreflang="<%= code %>" href="<%= _languageUrl(code) %>" />
<% }) %>

<!-- Open Graph -->
<meta property="og:type" content="<%= _ogType %>" />
<meta property="og:locale" content="<%= _lang === 'id' ? 'id_ID' : 'en_US' %>" />
<meta property="og:site_name" content="<%= _site.name || "Sagita Wedding" %>" />
<meta property="og:title" content="<%= _pageTitle %>" />
<meta property="og:description" content="<%= _description %>" />
<meta property="og:url" content="<%= _canonical %>" />
<meta property="og:image" content="<%= _ogImage %>" />
<meta property="og:image:alt" content="<%= _pageTitle %>" />
<% if (_articleMeta && _articleMeta.datePublished) { %>
<meta property="article:published_time" content="<%= _articleMeta.datePublished %>" />
<% } %>
<% if (_articleMeta && (_articleMeta.dateModified || _articleMeta.datePublished)) { %>
<meta property="article:modified_time" content="<%= _articleMeta.dateModified || _articleMeta.datePublished %>" />
<% } %>
<% if (_articleMeta && _articleMeta.section) { %>
<meta property="article:section" content="<%= _articleMeta.section %>" />
<% } %>

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%= _pageTitle %>" />
<meta name="twitter:description" content="<%= _description %>" />
<meta name="twitter:image" content="<%= _ogImage %>" />
<meta name="twitter:image:alt" content="<%= _pageTitle %>" />

<!-- Favicon dinamis (dari Identitas Website) -->
<link rel="icon" href="<%= _favicon %>" />
<link rel="apple-touch-icon" href="<%= _favicon %>" />

<% if (_site.siteVerification) { %>
<!-- Google Search Console verification (dari Identitas Website) -->
<meta name="google-site-verification" content="<%= _site.siteVerification %>" />
<% } %>

<!-- Structured data: Organization & WebSite -->
<script type="application/ld+json"><%- JSON.stringify(_jsonLd).replace(/</g, "\\u003c") %></script>

<% if (_site.gaId) { %>
<!-- Google Analytics 4 (ID dari Identitas Website) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=<%= encodeURIComponent(_site.gaId) %>"></script>
<script nonce="<%= nonce %>">
  window.dataLayer = window.dataLayer || [];
  function gtag(){ dataLayer.push(arguments); }
  gtag("js", new Date());
  gtag("config", "<%= _site.gaId %>");
</script>
<% } %>

<link rel="preload" as="image" href="<%= _site.logoUrl || "/img/logo-nav.png" %>" fetchpriority="high" />
<% if (typeof heroImage !== "undefined" && heroImage) { %>
  <link rel="preload" as="image" href="<%= heroImage %>" fetchpriority="high" />
<% } %>
<link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/cormorant-garamond-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/pinyon-script-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/css/output.css?v=<%= assetV %>-elegant-palette-v2" as="style" />
<link rel="stylesheet" href="/css/output.css?v=<%= assetV %>-elegant-palette-v2" />
<link rel="preload" href="/css/custom.css?v=<%= assetV %>-elegant-palette-v2" as="style" />
<link rel="stylesheet" href="/css/custom.css?v=<%= assetV %>-elegant-palette-v2" />

<script nonce="<%= nonce %>">
  (function () {
    try {
      const saved = localStorage.getItem("serene-dark");
      const prefers = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (saved === "true" || (!saved && prefers))
        document.documentElement.classList.add("dark");
    } catch (e) {}
  })();
</script>
<script src="/js/telemetry.js?v=<%= assetV %>" defer></script>
