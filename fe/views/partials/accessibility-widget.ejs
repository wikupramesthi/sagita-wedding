<div id="accessibilityWidget" class="accessibility-widget">
  <section id="accessibilityPanel" class="accessibility-panel" role="region" aria-labelledby="accessibilityTitle" hidden>
    <div class="accessibility-panel-header">
      <div>
        <h2 id="accessibilityTitle"><%= t.accessibility.title %></h2>
        <p><%= t.accessibility.subtitle %></p>
      </div>
      <button type="button" class="accessibility-close" data-a11y-close aria-label="<%= t.accessibility.close %>">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m18 6-12 12M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="accessibility-text-size">
      <span class="accessibility-label"><%= t.accessibility.textSize %></span>
      <div class="accessibility-size-controls" role="group" aria-label="<%= t.accessibility.textSize %>">
        <button type="button" data-a11y-size="down" aria-label="<%= t.accessibility.decrease %>">A−</button>
        <button type="button" data-a11y-size="reset" data-a11y-size-value data-standard="<%= t.accessibility.standard %>" aria-label="<%= t.accessibility.reset %>"><%= t.accessibility.standard %></button>
        <button type="button" data-a11y-size="up" aria-label="<%= t.accessibility.increase %>">A+</button>
      </div>
    </div>

    <div class="accessibility-options">
      <button type="button" class="accessibility-option" data-a11y-toggle="contrast" aria-pressed="false">
        <span class="accessibility-option-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18Z"/></svg>
        </span>
        <span><%= t.accessibility.contrast %></span>
        <span class="accessibility-switch" aria-hidden="true"></span>
      </button>
      <button type="button" class="accessibility-option" data-a11y-toggle="grayscale" aria-pressed="false">
        <span class="accessibility-option-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3a9 9 0 1 0 0 18V3Z"/><path d="M12 3a9 9 0 0 1 0 18M12 7v10"/></svg>
        </span>
        <span><%= t.accessibility.grayscale %></span>
        <span class="accessibility-switch" aria-hidden="true"></span>
      </button>
      <button type="button" class="accessibility-option" data-a11y-toggle="underline" aria-pressed="false">
        <span class="accessibility-option-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 4v7a7 7 0 0 0 14 0V4M4 21h16"/></svg>
        </span>
        <span><%= t.accessibility.underline %></span>
        <span class="accessibility-switch" aria-hidden="true"></span>
      </button>
      <button type="button" class="accessibility-option" data-a11y-toggle="motion" aria-pressed="false">
        <span class="accessibility-option-icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 12h16M4 6h10M4 18h7"/><path d="m18 4 2 2-2 2"/></svg>
        </span>
        <span><%= t.accessibility.motion %></span>
        <span class="accessibility-switch" aria-hidden="true"></span>
      </button>
    </div>

    <button type="button" class="accessibility-reset" data-a11y-reset><%= t.accessibility.resetAll %></button>
  </section>

  <button type="button" id="accessibilityTrigger" class="accessibility-trigger" aria-controls="accessibilityPanel" aria-expanded="false" aria-label="<%= t.accessibility.open %>" title="<%= t.accessibility.open %>">
    <svg xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" aria-hidden="true"><circle cx="12" cy="12" r="9.25"/><circle cx="12" cy="7.5" r="1.25" fill="currentColor" stroke="none"/><path d="M5.5 10.25h13M12 9.5v9M9 20l3-5 3 5M8.25 11.5l-1.5 4M15.75 11.5l1.5 4"/></svg>
    <span class="accessibility-trigger-label"><%= t.accessibility.title %></span>
  </button>
</div>
