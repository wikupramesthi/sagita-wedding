<!DOCTYPE html>
<html lang="<%= lang || 'en' %>">

<head>
    <%- include('../partials/head') %>
</head>

<body class="antialiased bg-cream">
    <% const vendorCategories = [...new Set((vendors || []).flatMap((vendor) => (vendor.vendors_categories || []).map((category) => category.name).filter(Boolean)))]; %>
    <% const categoryCount = (category) => vendors.filter((vendor) => (vendor.vendors_categories || []).some((item) => item.name === category)).length; %>

    <%- include('../partials/navbar') %>


    <!-- HEADER -->
    <section class="vendors-hero relative isolate overflow-hidden">
        <div aria-hidden="true" class="pointer-events-none absolute -right-20 -top-32 h-80 w-80 rounded-full border border-white/10"></div>
        <div aria-hidden="true" class="pointer-events-none absolute -right-8 -top-20 h-56 w-56 rounded-full border border-white/10"></div>
        <div class="relative mx-auto grid max-w-7xl items-center gap-8 px-4 pb-10 pt-28 sm:px-6 sm:pb-14 sm:pt-36 lg:grid-cols-[minmax(0,1fr)_auto] lg:px-8 lg:pb-16">
            <div class="max-w-3xl">
                <p class="mb-3 text-xs font-semibold uppercase tracking-[0.22em] text-sand-200"><%= t.nav.vendors %></p>
                <h1 class="font-display text-4xl font-semibold leading-[1.08] text-white sm:text-5xl lg:text-6xl">
                    <%= t.vendorsTitleA %>
                    <span class="text-sand-200"><%= t.vendorsTitleB %></span>
                </h1>
                <p class="vendors-hero-description mt-4 max-w-2xl text-sm leading-relaxed sm:text-base">
                    <%= t.vendorsDesc %>
                </p>
            </div>

            <div class="flex w-fit items-center gap-4 rounded-2xl border border-white/20 bg-white/10 px-5 py-3 shadow-sm backdrop-blur-sm sm:px-6 sm:py-4">
                <span class="font-display text-4xl font-semibold leading-none text-white sm:text-5xl"><%= vendors.length %></span>
                <span class="max-w-24 text-xs font-medium leading-snug text-white/75 sm:text-sm"><%= t.vendorsPage.vendorCount %></span>
            </div>
        </div>
    </section>


    <!-- VENDORS -->
    <section class="mx-auto max-w-7xl px-4 pb-14 pt-8 sm:px-6 sm:pb-20 sm:pt-10 lg:px-8">

        <% if (vendors && vendors.length > 0) { %>

            <div class="mb-6 flex flex-col gap-3 sm:mb-8 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                    <h2 class="font-display text-lg font-semibold text-sage-900"><%= t.vendorsPage.filterLabel %></h2>
                    <p class="mt-1 text-xs text-stone-warm"><span id="vendorResultCount"><%= vendors.length %></span> <%= t.vendorsPage.vendorCount %></p>
                </div>
                <div class="-mx-4 flex gap-2 overflow-x-auto px-4 pb-2 sm:mx-0 sm:flex-wrap sm:overflow-visible sm:px-0 sm:pb-0" role="group" aria-label="<%= t.vendorsPage.filterLabel %>">
                    <button type="button" class="vendor-filter inline-flex min-h-10 shrink-0 items-center gap-2 rounded-full bg-sage-900 px-4 py-2 text-xs font-semibold text-white shadow-sm ring-1 ring-sage-900 transition-colors" data-category="" aria-pressed="true">
                        <%= t.vendorsPage.allVendors %>
                        <span class="grid h-5 min-w-5 place-items-center rounded-full bg-white/15 px-1 text-[10px]"><%= vendors.length %></span>
                    </button>
                    <% vendorCategories.forEach((category) => { %>
                        <button type="button" class="vendor-filter inline-flex min-h-10 shrink-0 items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-semibold text-sage-700 shadow-sm ring-1 ring-sand-200 transition-colors hover:bg-sand-100" data-category="<%= category %>" aria-pressed="false">
                            <%= category %>
                            <span class="grid h-5 min-w-5 place-items-center rounded-full bg-sand-100 px-1 text-[10px] text-sage-700"><%= categoryCount(category) %></span>
                        </button>
                    <% }) %>
                </div>
            </div>

            <div id="vendorGrid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-7">

                <% vendors.forEach(v => { %>

                    <article
                        class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-sand-200/80 bg-white shadow-[0_8px_30px_rgba(64,58,52,0.06)] transition duration-300 hover:-translate-y-1 hover:border-sand-300 hover:shadow-[0_18px_48px_rgba(64,58,52,0.12)]"
                        data-vendor-card
                        data-categories="<%= JSON.stringify((v.vendors_categories || []).map((category) => category.name).filter(Boolean)) %>"
                    >

                        <!-- IMAGE -->
                        <div class="relative h-48 overflow-hidden bg-gradient-to-br from-[#eee8dc] via-[#f8f5ef] to-[#ddd7cb] sm:h-56">
                            <div aria-hidden="true" class="absolute -right-10 -top-14 h-52 w-52 rounded-full border border-white/60"></div>
                            <div aria-hidden="true" class="absolute -right-2 -top-6 h-36 w-36 rounded-full border border-white/60"></div>
                            <div class="absolute inset-0 flex items-end justify-between px-6 pb-5">
                                <span class="font-display text-8xl font-medium leading-[0.8] text-sage-800/20 sm:text-9xl">
                                    <%= (v.name || '?').charAt(0).toUpperCase() %>
                                </span>
                                <span class="mb-1 font-display text-sm italic tracking-wide text-sage-800/45"><%= v.name %></span>
                            </div>

                            <% if (v.avatar) { %>
                                <img
                                    src="<%= v.avatar %>"
                                    alt="<%= v.name %>"
                                    data-img-error="remove"
                                    class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]"
                                >
                            <% } %>


                            <!-- VENDOR CATEGORIES -->
                            <% if (
                                v.vendors_categories &&
                                v.vendors_categories.length > 0
                            ) { %>

                                <div class="absolute left-4 top-4 right-4 flex flex-wrap gap-2">

                                    <% v.vendors_categories.slice(0, 2).forEach(spec => { %>

                                        <span
                                            class="rounded-full border border-white/70 bg-white/90 px-3 py-1.5 text-[10px] font-semibold text-sage-800 shadow-sm backdrop-blur-sm"
                                        >
                                            <%= spec.name %>
                                        </span>

                                    <% }) %>


                                    <% if (v.vendors_categories.length > 2) { %>

                                        <span
                                            class="rounded-full bg-sage-800/90 px-3 py-1.5 text-[10px] font-semibold text-white"
                                        >
                                            +<%= v.vendors_categories.length - 2 %>
                                        </span>

                                    <% } %>

                                </div>

                            <% } %>

                        </div>


                        <!-- CONTENT -->
                        <div class="flex flex-1 flex-col p-5 sm:p-6">

                            <!-- NAME -->
                            <h2 class="font-display text-2xl font-semibold leading-snug text-sage-900 sm:text-[1.7rem]">
                                <%= v.name %>
                            </h2>


                            <!-- EXPERIENCE -->
                            <% if (v.pengalaman) { %>

                                <p class="mt-2 text-xs font-medium text-terracotta-700">
                                    <%= v.pengalaman %>
                                </p>

                            <% } %>


                            <!-- BIO -->
                            <% if (v.biografi) { %>

                                <p class="mt-4 line-clamp-3 min-h-[4.5rem] text-sm leading-relaxed text-stone-warm">
                                    <%= v.biografi %>
                                </p>

                            <% } else { %>

                                <p class="mt-4 line-clamp-3 min-h-[4.5rem] text-sm leading-relaxed text-stone-400">
                                    Yoga vendor at YogaRoots, guiding every practice with
                                    mindful movement and intention.
                                </p>

                            <% } %>


                            <!-- FOOTER -->
                            <div class="mt-auto flex items-center justify-between gap-3 border-t border-sand-200 pt-4">

                                <div class="flex items-center gap-2">

                                    <span class="w-1.5 h-1.5 rounded-full bg-sage-500"></span>

                                    <span class="text-xs text-stone-400">
                                        Vendor
                                    </span>

                                </div>

                                <button
                                    type="button"
                                    data-action="open-booking"
                                    data-class-name="Private with <%= v.name %>"
                                    class="inline-flex min-h-10 items-center gap-2 rounded-full bg-sage-700 px-4 py-2 text-xs font-semibold text-white transition hover:bg-sage-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-sage-500 focus-visible:ring-offset-2"
                                >
                                    Book a Session
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4">
                                        <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.69L10.22 5.03a.75.75 0 1 1 1.06-1.06l5.5 5.5a.75.75 0 0 1 0 1.06l-5.5 5.5a.75.75 0 1 1-1.06-1.06l4.22-4.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                                    </svg>
                                </button>

                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>

            <div id="vendorEmpty" class="mt-6 hidden rounded-3xl border border-sand-200 bg-white px-6 py-12 text-center">
                <h3 class="font-display text-xl font-semibold text-sage-900"><%= t.vendorsPage.noResultsTitle %></h3>
                <p class="mt-2 text-sm text-stone-warm"><%= t.vendorsPage.noResultsDesc %></p>
                <button type="button" data-vendor-reset class="mt-5 inline-flex min-h-10 items-center rounded-full bg-sage-800 px-5 py-2 text-sm font-semibold text-white transition hover:bg-sage-900">
                    <%= t.vendorsPage.clearFilter %>
                </button>
            </div>


        <% } else { %>


            <!-- EMPTY STATE -->
            <div class="bg-white rounded-[24px] border border-sage-100 py-16 px-6 text-center">

                <div
                    class="w-14 h-14 mx-auto rounded-full bg-sage-50 flex items-center justify-center"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        class="w-7 h-7 text-sage-600"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                        />

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4.5 20.25a7.5 7.5 0 0 1 15 0"
                        />
                    </svg>

                </div>


                <h3 class="font-display text-2xl font-semibold text-sage-900 mt-5">
                    No vendors available
                </h3>


                <p class="text-sm text-stone-warm mt-2">
                    Vendor profiles will appear here soon.
                </p>

            </div>


        <% } %>

         <%- include('../partials/cta-help') %>

    </section>


    <%- include('../partials/footer') %>


    <!-- main.js dimuat sekali via partials/footer -->

</body>

</html>