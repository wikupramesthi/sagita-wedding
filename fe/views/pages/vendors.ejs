<!DOCTYPE html>
<html lang="<%= lang || 'en' %>">

<head>
    <%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-sand-50 antialiased">
    <% const vendorList = Array.isArray(vendors) ? vendors : []; %>
    <% const vendorCategories = [...new Set(vendorList.flatMap((vendor) => (vendor.vendors_categories || []).map((category) => category.name).filter(Boolean)))]; %>
    <% const categoryCount = (category) => vendorList.filter((vendor) => (vendor.vendors_categories || []).some((item) => item.name === category)).length; %>

    <%- include('../partials/navbar') %>

    <main>
        <section class="relative isolate overflow-hidden" style="background: radial-gradient(ellipse 42% 85% at 82% 45%, rgba(183,159,128,.20) 0%, transparent 76%), radial-gradient(ellipse 40% 70% at 4% 92%, rgba(207,187,160,.18) 0%, transparent 74%), linear-gradient(125deg, #fbf9f6 0%, #f6f1ea 54%, #eee7de 100%)">
            <div aria-hidden="true" class="absolute -right-32 -top-36 h-[34rem] w-[34rem] rounded-full border border-[#b79f80]/20"></div>
            <div aria-hidden="true" class="absolute -right-16 -top-20 h-[25rem] w-[25rem] rounded-full border border-[#b79f80]/20"></div>
            <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-white/35 to-transparent"></div>
            <div class="site-container relative mx-auto grid items-center gap-10 pb-14 pt-24 sm:pb-20 sm:pt-28 lg:grid-cols-2 lg:gap-16 lg:pb-16 lg:pt-32" style="position:relative;z-index:1;padding-top:clamp(7rem,14vh,8rem)">
                <div class="max-w-3xl">
                    <p class="mb-4 text-[11px] font-semibold uppercase tracking-[0.24em] text-[#89745f]"><%= t.vendorsPage.eyebrow %></p>
                    <h1 class="font-display text-4xl leading-[1.08] tracking-tight text-[#403a34] sm:text-5xl lg:text-[3.25rem] xl:text-6xl">
                        <%= t.vendorsPage.titleA %>
                        <span class="block italic font-light text-[#89745f]"><%= t.vendorsPage.titleB %></span>
                    </h1>
                    <p class="mt-6 max-w-2xl text-base leading-relaxed text-stone-warm sm:text-lg"><%= t.vendorsPage.description %></p>
                    <a href="/formulir-konsultasi" class="vendor-consultation-cta mt-8 inline-flex min-h-12 items-center gap-3 rounded-full px-6 py-3 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2">
                        <%= t.vendorsPage.consultationCta %>
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.69L10.22 5.03a.75.75 0 1 1 1.06-1.06l5.5 5.5a.75.75 0 0 1 0 1.06l-5.5 5.5a.75.75 0 1 1-1.06-1.06l4.22-4.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>
                    </a>
                </div>

                <div class="relative mx-auto flex min-h-72 w-full items-center justify-center overflow-hidden rounded-[2rem] border border-white/75 px-7 py-10 shadow-[0_24px_70px_rgba(64,58,52,0.12)] lg:min-h-[25rem]" style="background: linear-gradient(145deg, rgba(255,255,255,.82), rgba(250,247,242,.78) 55%, rgba(239,231,220,.82))">
                    <div aria-hidden="true" class="absolute -right-16 -top-20 h-56 w-56 rounded-full bg-[#b79f80]/15 blur-2xl"></div>
                    <div aria-hidden="true" class="absolute -bottom-20 -left-16 h-52 w-52 rounded-full bg-[#cfbba0]/20 blur-2xl"></div>
                    <div aria-hidden="true" class="absolute inset-4 rounded-[1.5rem] border border-[#b79f80]/15"></div>
                    <svg aria-hidden="true" viewBox="0 0 420 440" fill="none" style="position:absolute;z-index:0;pointer-events:none;width:100%;height:100%;right:-15%;top:0;color:#89745f;opacity:.24">
                        <path d="M383 432C341 367 336 309 291 260C247 211 215 174 207 115C202 79 207 47 222 16" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                        <path d="M328 361C285 360 254 339 236 303C270 296 302 314 328 361ZM292 264C250 264 221 242 205 208C242 201 273 220 292 264ZM240 183C202 172 183 144 178 107C213 111 235 138 240 183ZM207 116C174 101 160 72 163 38C195 48 211 76 207 116Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
                        <path d="M322 352C341 311 372 294 410 296C399 331 369 351 322 352ZM282 249C303 210 335 195 372 200C358 234 327 252 282 249ZM231 169C261 140 295 135 328 149C309 179 276 188 231 169ZM204 104C237 83 270 85 299 104C275 130 241 132 204 104Z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
                        <g transform="translate(154 294)" stroke="currentColor" stroke-width="1.2">
                            <ellipse cy="-15" rx="5" ry="12"/><ellipse cy="-15" rx="5" ry="12" transform="rotate(60)"/><ellipse cy="-15" rx="5" ry="12" transform="rotate(120)"/><ellipse cy="-15" rx="5" ry="12" transform="rotate(180)"/><ellipse cy="-15" rx="5" ry="12" transform="rotate(240)"/><ellipse cy="-15" rx="5" ry="12" transform="rotate(300)"/><circle r="4" fill="currentColor" stroke="none"/>
                        </g>
                        <g transform="translate(137 174) scale(.72)" stroke="currentColor" stroke-width="1.4">
                            <ellipse cy="-15" rx="5" ry="12"/><ellipse cy="-15" rx="5" ry="12" transform="rotate(60)"/><ellipse cy="-15" rx="5" ry="12" transform="rotate(120)"/><ellipse cy="-15" rx="5" ry="12" transform="rotate(180)"/><ellipse cy="-15" rx="5" ry="12" transform="rotate(240)"/><ellipse cy="-15" rx="5" ry="12" transform="rotate(300)"/><circle r="4" fill="currentColor" stroke="none"/>
                        </g>
                        <path d="M350 400C324 380 309 361 300 337M280 270C255 252 237 232 224 207M228 183C208 164 195 143 187 119" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-dasharray="1 7"/>
                    </svg>
                    <div class="relative max-w-xs text-center" style="z-index:1">
                        <div class="mx-auto mb-5 grid h-14 w-14 place-items-center rounded-2xl border border-[#b79f80]/30 bg-white/80 text-[#89745f] shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" aria-hidden="true" class="h-8 w-8">
                            <path d="M24 39C20 33 10 29 10 18a8 8 0 0 1 14-5 8 8 0 0 1 14 5c0 11-10 15-14 21Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M24 13v25M18 22c2 1 4 3 6 6m6-6c-2 1-4 3-6 6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" />
                        </svg>
                        </div>
                        <p class="font-display text-2xl italic leading-tight text-[#403a34] sm:text-3xl"><%= t.vendorsPage.visualTitle %></p>
                        <p class="mx-auto mt-3 max-w-xs text-sm leading-relaxed text-stone-warm"><%= t.vendorsPage.visualDescription %></p>
                        <div class="mx-auto mt-6 flex w-fit items-center gap-2 border-t border-[#b79f80]/35 px-2 pt-4 text-xs font-semibold uppercase tracking-[0.14em] text-[#89745f]" style="border-color:rgba(183,159,128,.35)">
                            <span class="h-1.5 w-1.5 rounded-full bg-[#b79f80]"></span>
                            <%= vendorList.length %> <%= t.vendorsPage.vendorCount %>
                        </div>
                    </div>
                </div>
            </div>
        </section>


    <!-- VENDORS -->
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-14">
        <div class="mb-10 max-w-2xl">
            <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-[#89745f]"><%= t.vendorsPage.directoryEyebrow %></p>
            <h2 class="font-display text-3xl leading-tight text-[#403a34] sm:text-4xl"><%= t.vendorsPage.directoryTitle %></h2>
            <p class="mt-3 text-sm leading-relaxed text-stone-warm sm:text-base"><%= t.vendorsPage.directoryDescription %></p>
        </div>

        <% if (vendorList.length > 0) { %>

            <div class="mb-6 flex flex-col gap-3 sm:mb-8 sm:flex-row sm:items-center sm:justify-between">
                <div class="min-w-0">
                    <h2 class="font-display text-lg font-semibold text-[#403a34]"><%= t.vendorsPage.filterLabel %></h2>
                    <p class="mt-1 text-xs text-stone-warm"><span id="vendorResultCount"><%= vendorList.length %></span> <%= t.vendorsPage.vendorCount %></p>
                </div>
                <div class="flex flex-wrap gap-2" role="group" aria-label="<%= t.vendorsPage.filterLabel %>">
                    <button type="button" class="vendor-filter inline-flex min-h-10 shrink-0 items-center gap-2 rounded-full bg-sage-800 px-4 py-2 text-xs font-semibold text-white shadow-sm ring-1 ring-sage-800 transition-colors" data-category="" aria-pressed="true">
                        <%= t.vendorsPage.allVendors %>
                        <span class="grid h-5 min-w-5 place-items-center rounded-full bg-white/20 px-1 text-[10px]" style="background-color:rgba(255,255,255,.2)"><%= vendorList.length %></span>
                    </button>
                    <% vendorCategories.forEach((category) => { %>
                        <button type="button" class="vendor-filter inline-flex min-h-10 shrink-0 items-center gap-2 rounded-full bg-white px-4 py-2 text-xs font-semibold text-sage-800 shadow-sm ring-1 ring-sand-200 transition-colors hover:bg-sand-100" data-category="<%= category %>" aria-pressed="false">
                            <%= category %>
                            <span class="grid h-5 min-w-5 place-items-center rounded-full bg-sand-100 px-1 text-[10px] text-sage-800"><%= categoryCount(category) %></span>
                        </button>
                    <% }) %>
                </div>
            </div>

            <div id="vendorGrid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 lg:gap-7">

                <% vendorList.forEach(v => { %>

                    <article
                        class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-sand-200/80 bg-white shadow-[0_8px_30px_rgba(64,58,52,0.06)] transition duration-300 hover:-translate-y-1 hover:border-sand-300 hover:shadow-[0_18px_48px_rgba(64,58,52,0.12)]"
                        data-vendor-card
                        data-categories="<%= JSON.stringify((v.vendors_categories || []).map((category) => category.name).filter(Boolean)) %>"
                    >

                        <!-- IMAGE -->
                        <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-[#f1e9dd] via-[#faf7f1] to-[#e4d8c8]">
                            <div aria-hidden="true" class="absolute -right-10 -top-14 h-52 w-52 rounded-full border border-white/70"></div>
                            <div aria-hidden="true" class="absolute -right-2 -top-6 h-36 w-36 rounded-full border border-white/70"></div>
                            <div class="absolute inset-0 grid place-items-center">
                                <span class="grid h-24 w-24 place-items-center rounded-full border border-white/80 bg-white/70 font-display text-5xl font-light italic leading-none text-sage-800/70 shadow-sm backdrop-blur-sm"><%= (v.name || '?').charAt(0).toUpperCase() %></span>
                            </div>

                            <% if (v.avatar) { %>
                                <img
                                    src="<%= v.avatar %>"
                                    alt="<%= v.name %>"
                                    data-img-error="remove"
                                    class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-[1.04]"
                                >
                            <% } %>


                            <!-- VENDOR CATEGORIES -->
                            <% if (
                                v.vendors_categories &&
                                v.vendors_categories.length > 0
                            ) { %>

                                <div class="absolute left-4 top-4 right-4 flex flex-wrap gap-2">

                                    <% v.vendors_categories.slice(0, 2).forEach(spec => { %>

                                        <span
                                            class="rounded-full border border-white/70 bg-white/90 px-3 py-1.5 text-[10px] font-semibold text-sage-800 shadow-sm backdrop-blur-sm"
                                        >
                                            <%= spec.name %>
                                        </span>

                                    <% }) %>


                                    <% if (v.vendors_categories.length > 2) { %>

                                        <span
                                            class="rounded-full bg-sage-800/90 px-3 py-1.5 text-[10px] font-semibold text-white"
                                        >
                                            +<%= v.vendors_categories.length - 2 %>
                                        </span>

                                    <% } %>

                                </div>

                            <% } %>

                        </div>


                        <!-- CONTENT -->
                        <div class="flex flex-1 flex-col p-5 sm:p-6">

                            <!-- NAME -->
                            <h2 class="font-display text-2xl font-semibold leading-snug text-[#403a34] sm:text-[1.7rem]">
                                <%= v.name %>
                            </h2>


                            <p class="mt-3 min-h-[4.5rem] text-sm leading-relaxed text-stone-warm">
                                <%= t.vendorsPage.cardDescription %>
                            </p>


                            <!-- FOOTER -->
                            <div class="mt-auto flex items-center justify-between gap-3 border-t border-sand-200 pt-4">

                                <span class="inline-flex shrink-0 items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.1em] text-[#89745f]">
                                    <span class="h-1.5 w-1.5 rounded-full bg-[#b79f80]"></span>
                                    <%= t.vendorsPage.vendorLabel %>
                                </span>

                                <a href="https://wa.me/<%= contactLinks.whatsappNumber %>?text=<%= encodeURIComponent(t.vendorsPage.vendorMessage.replace('{vendor}', v.name || '')) %>" target="_blank" rel="noopener noreferrer" class="vendor-detail-cta inline-flex min-h-10 shrink-0 items-center gap-2 text-xs font-semibold" style="background-color:var(--color-sage-700);color:#fff;border-radius:9999px;padding:0.625rem 1rem;text-decoration:none;box-shadow:0 4px 12px rgba(44,64,53,.16)">
                                    <%= t.vendorsPage.cardCta %>
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4">
                                        <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.69L10.22 5.03a.75.75 0 1 1 1.06-1.06l5.5 5.5a.75.75 0 0 1 0 1.06l-5.5 5.5a.75.75 0 1 1-1.06-1.06l4.22-4.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                                    </svg>
                                </a>

                            </div>

                        </div>

                    </article>

                <% }) %>

            </div>

            <div id="vendorEmpty" class="mt-6 hidden rounded-3xl border border-sand-200 bg-white px-6 py-12 text-center">
                <h3 class="font-display text-xl font-semibold text-[#403a34]"><%= t.vendorsPage.noResultsTitle %></h3>
                <p class="mt-2 text-sm text-stone-warm"><%= t.vendorsPage.noResultsDesc %></p>
                <button type="button" data-vendor-reset class="mt-5 inline-flex min-h-10 items-center rounded-full bg-sage-800 px-5 py-2 text-sm font-semibold text-white transition hover:bg-sage-900">
                    <%= t.vendorsPage.clearFilter %>
                </button>
            </div>


        <% } else { %>


            <!-- EMPTY STATE -->
            <div class="rounded-[2rem] border border-sand-200 bg-white px-6 py-16 text-center shadow-[0_16px_50px_rgba(64,58,52,0.06)]">

                <div
                    class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-sand-100"
                >

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        class="w-7 h-7 text-[#89745f]"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z"
                        />

                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4.5 20.25a7.5 7.5 0 0 1 15 0"
                        />
                    </svg>

                </div>


                <h3 class="mt-5 font-display text-2xl font-semibold text-[#403a34]">
                    <%= t.vendorsPage.emptyTitle %>
                </h3>

                <p class="mx-auto mt-2 max-w-xl text-sm leading-relaxed text-stone-warm"><%= t.vendorsPage.emptyDescription %></p>
                <a href="/formulir-konsultasi" class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-full bg-sage-900 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-sage-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold focus-visible:ring-offset-2">
                    <%= t.vendorsPage.consultationCta %>
                </a>

            </div>


        <% } %>

    </section>

    <section class="px-6 pb-16 sm:pb-24">
        <div class="relative mx-auto max-w-7xl overflow-hidden rounded-[2rem] px-6 py-10 text-center text-white sm:px-12 sm:py-14" style="background-color:var(--color-sage-900)">
            <div aria-hidden="true" class="absolute -right-12 -top-24 h-64 w-64 rounded-full border border-white/10"></div>
            <div aria-hidden="true" class="absolute -right-4 -top-16 h-48 w-48 rounded-full border border-white/10"></div>
            <div class="relative mx-auto max-w-2xl">
                <p class="mb-3 text-[11px] font-semibold uppercase tracking-[0.22em] text-gold-light"><%= t.vendorsPage.eyebrow %></p>
                <h2 class="font-display text-3xl leading-tight sm:text-4xl"><%= t.vendorsPage.closingTitle %></h2>
                <p class="mt-4 text-sm leading-relaxed text-white/75 sm:text-base"><%= t.vendorsPage.closingDescription %></p>
                <a href="/formulir-konsultasi" class="mt-7 inline-flex min-h-11 items-center gap-3 rounded-full bg-white px-6 py-3 text-sm font-semibold text-[#403a34] transition hover:-translate-y-0.5 hover:bg-[#f8f6f2] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-[#403a34]">
                    <%= t.vendorsPage.closingCta %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="h-4 w-4"><path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.69L10.22 5.03a.75.75 0 1 1 1.06-1.06l5.5 5.5a.75.75 0 0 1 0 1.06l-5.5 5.5a.75.75 0 1 1-1.06-1.06l4.22-4.22H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" /></svg>
                </a>
            </div>
        </div>
    </section>

    </main>

    <%- include('../partials/footer') %>


</body>

</html>