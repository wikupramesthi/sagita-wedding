    titleB: 'dirancang untuk Anda',
    subtitle: 'MERANGKAI MOMEN, MEWUJUDKAN IMPIAN',
    hero: 'Kami mendampingi setiap langkah persiapan, menyatukan detail dan orang-orang di balik perayaan yang terasa personal.',
    learn: 'Kenali pendekatan kami',
    consult: 'Mulai konsultasi',
    visualEyebrow: 'HARI YANG BERARTI',
    visualTitle: 'Cerita Anda, dirangkai dengan penuh perhatian.',
    visualNote: 'Dari percakapan pertama hingga hari perayaan',
    stats: [{ value: '01', label: 'Pendekatan personal' }, { value: '02', label: 'Koordinasi menyeluruh' }, { value: '03', label: 'Dukungan hari-H' }],
    aboutEyebrow: 'Cerita kami',
    aboutTitle: 'Perencanaan yang memberi ruang untuk menikmati setiap momen',
    aboutP1: 'Pernikahan adalah tentang dua cerita, keluarga, dan hal-hal kecil yang membuat sebuah perayaan terasa begitu berarti. Kami hadir untuk memahami apa yang penting bagi Anda, lalu membantu menyusunnya menjadi rencana yang jelas dan terarah.',
    aboutP2: 'Bersama tim Sagita, Anda dapat mendiskusikan konsep, anggaran, vendor, dan alur acara dengan lebih tenang. Setiap rekomendasi disesuaikan dengan kebutuhan Anda—bukan sekadar mengikuti tren.',
    aboutPill: 'Pendampingan yang berangkat dari cerita Anda',
    valuesEyebrow: 'Keunggulan Wedding Organizer',
    valuesTitle: 'Detail yang menyatu,',
    valuesTitleAccent: 'perayaan yang terasa utuh',
    values: [
      { title: 'Perencanaan personal', desc: 'Kami memahami cerita, prioritas, dan harapan Anda sebelum menyusun rencana.' },
      { title: 'Konsep sesuai cerita', desc: 'Setiap pilihan mencerminkan karakter dan suasana pernikahan yang Anda inginkan.' },
      { title: 'Anggaran dan jadwal jelas', desc: 'Anggaran, jadwal, dan tanggung jawab dibahas secara terbuka sejak awal.' },
      { title: 'Koordinasi vendor', desc: 'Kami menyelaraskan komunikasi dan kebutuhan seluruh vendor.' },
      { title: 'Detail hari-H terjaga', desc: 'Dari persiapan hingga alur acara, setiap detail mendapat perhatian.' },
      { title: 'Nikmati setiap momen', desc: 'Koordinasi yang tertata memberi Anda ruang untuk menikmati hari istimewa.' },
