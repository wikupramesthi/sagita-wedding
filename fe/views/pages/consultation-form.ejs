<!DOCTYPE html>
<html lang="<%= lang || 'id' %>">
  <head>
    <%- include('../partials/head') %>
  </head>

  <body class="consultation-page min-h-screen antialiased">
    <%
      const pageCopy = typeof cmsPage !== 'undefined' && cmsPage ? cmsPage : null;
      const copy = lang === "en" ? {
        eyebrow: "A thoughtful beginning",
        title: "Let’s plan a day",
        titleAccent: "that feels like you.",
        intro: "Tell us a little about the celebration you have in mind. Our team will help you explore the services, packages, and next steps that best fit your plans.",
        detailsTitle: "Wedding planning shaped around your celebration",
        detailsText: "Discuss full-service planning, wedding-day coordination, vendor recommendations, and package or budget options with Sagita Wedding Planner.",
        private: "We’ll use your information only to follow up on this consultation.",
        stepOne: "About you",
        stepTwo: "Your celebration",
        name: "Full name",
        namePlaceholder: "Your name",
        email: "Email address",
        emailPlaceholder: "name@example.com",
        phone: "WhatsApp number",
        phonePlaceholder: "e.g. 0812 3456 7890",
        date: "Estimated wedding date",
        dateHint: "It’s okay if the date isn’t set yet.",
        city: "Wedding city",
        cityPlaceholder: "e.g. Jakarta",
        venue: "Venue (if decided)",
        venuePlaceholder: "Venue name or area",
        guests: "Estimated guests",
        choose: "Choose an estimate",
        guestsOptions: ["Under 100 guests", "100–300 guests", "300–500 guests", "More than 500 guests", "Not sure yet"],
        budget: "Estimated budget",
        budgetOptions: ["Under IDR 100 million", "IDR 100–250 million", "IDR 250–500 million", "Over IDR 500 million", "Still exploring"],
        service: "What would you like help with?",
        serviceOptions: ["Full wedding planning", "Wedding day coordination", "Venue & vendor recommendations", "Budget & package consultation"],
        message: "Anything else we should know?",
        messagePlaceholder: "Share your ideas, priorities, or questions…",
        captcha: "Quick verification",
        captchaLoading: "Preparing a quick verification…",
        captchaRetry: "Reload verification",
        submit: "Send consultation request",
        sending: "Sending your request…",
        successTitle: "Thank you for reaching out.",
        successText: "We’ve received your consultation request. Our team will be in touch soon to learn more about your plans and discuss the next steps.",
        successTagline: "Weaving Moments, Realizing Dreams.",
        whatsappConfirm: "Got it",
        errorFallback: "We couldn’t send your request. Please try again.",
        footer: "A warm conversation is the first step to a meaningful celebration.",
        back: "Back to website",
        required: "Required",
      } : {
        eyebrow: "Awal yang penuh makna",
        title: "Mari rencanakan hari",
        titleAccent: "yang terasa seperti Anda.",
        intro: "Ceritakan sedikit tentang pernikahan yang Anda impikan. Tim kami akan membantu menjajaki layanan, paket, dan langkah berikutnya yang paling sesuai dengan rencana Anda.",
        detailsTitle: "Rencana pernikahan, dibahas bersama",
        detailsText: "Diskusikan perencanaan pernikahan, koordinasi di hari pernikahan, rekomendasi vendor, serta pilihan paket dan anggaran bersama Sagita Wedding Planner.",
        private: "Informasi Anda hanya digunakan untuk menindaklanjuti konsultasi ini.",
        stepOne: "Tentang Anda",
        stepTwo: "Rencana pernikahan",
        name: "Nama lengkap",
        namePlaceholder: "Nama Anda",
        email: "Alamat email",
        emailPlaceholder: "nama@email.com",
        phone: "Nomor WhatsApp",
        phonePlaceholder: "Contoh: 0812 3456 7890",
        date: "Perkiraan tanggal pernikahan",
        dateHint: "Tidak masalah jika tanggalnya belum ditentukan.",
        city: "Kota pernikahan",
        cityPlaceholder: "Contoh: Jakarta",
        venue: "Lokasi atau venue (jika sudah ada)",
        venuePlaceholder: "Nama venue atau area",
        guests: "Perkiraan jumlah tamu",
        choose: "Pilih perkiraan",
        guestsOptions: ["Di bawah 100 tamu", "100–300 tamu", "300–500 tamu", "Lebih dari 500 tamu", "Belum tahu"],
        budget: "Kisaran anggaran",
        budgetOptions: ["Di bawah Rp100 juta", "Rp100–250 juta", "Rp250–500 juta", "Di atas Rp500 juta", "Masih mencari gambaran"],
        service: "Layanan apa yang ingin Anda diskusikan?",
        serviceOptions: ["Perencanaan pernikahan menyeluruh", "Koordinasi di hari pernikahan", "Rekomendasi venue dan vendor", "Konsultasi anggaran dan paket"],
        message: "Hal lain yang ingin kami ketahui?",
        messagePlaceholder: "Ceritakan ide, prioritas, atau pertanyaan Anda…",
        captcha: "Verifikasi singkat",
        captchaLoading: "Menyiapkan verifikasi…",
        captchaRetry: "Muat ulang verifikasi",
        submit: "Kirim permintaan konsultasi",
        sending: "Mengirim permintaan…",
        successTitle: "Terima kasih telah menghubungi kami.",
        successText: "Permintaan konsultasi Anda telah kami terima. Tim kami akan segera menghubungi Anda untuk membicarakan rencana dan langkah berikutnya.",
        successTagline: "Merangkai Momen, Mewujudkan Impian.",
        whatsappConfirm: "Baik",
        errorFallback: "Permintaan belum terkirim. Silakan coba kembali.",
        footer: "Percakapan hangat adalah awal dari perayaan yang bermakna.",
        back: "Kembali ke website",
        required: "Wajib diisi",
      };
    %>

    <main class="consultation-shell">
      <a class="consultation-back" href="/" aria-label="<%= copy.back %>">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5m0 0 6 6m-6-6 6-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span><%= copy.back %></span>
      </a>

      <div class="consultation-layout">
        <section class="consultation-intro">
          <a class="consultation-brand" href="/" aria-label="Sagita Wedding Planner">
            <img src="<%= site.logoUrl || '/img/logo.WebP' %>" alt="Sagita Wedding Planner" width="160" height="48">
          </a>

          <div class="consultation-intro-copy">
            <span class="consultation-eyebrow"><span></span><%= copy.eyebrow %></span>
            <h1><%= copy.title %> <em><%= copy.titleAccent %></em></h1>
            <% if (pageCopy && pageCopy.content) { %>
              <div class="consultation-cms prose prose-stone max-w-none"><%- pageCopy.content %></div>
            <% } else { %>
              <p><%= copy.intro %></p>
            <% } %>
          </div>

          <% if (!pageCopy || !pageCopy.content) { %>
            <section class="consultation-seo" aria-labelledby="consultation-seo-heading">
              <h2 id="consultation-seo-heading"><%= copy.detailsTitle %></h2>
              <p><%= copy.detailsText %></p>
            </section>
          <% } %>

          <div class="consultation-trust">
            <span class="consultation-trust-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none"><path d="M12 3 5 6v5c0 4.5 3 8.2 7 10 4-1.8 7-5.5 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <p><%= copy.private %></p>
          </div>

          <p class="consultation-mantra"><%= copy.footer %></p>
          <span class="consultation-orbit consultation-orbit-one" aria-hidden="true"></span>
          <span class="consultation-orbit consultation-orbit-two" aria-hidden="true"></span>
        </section>

        <section class="consultation-form-panel" aria-label="<%= copy.title %>">
          <div class="consultation-form-heading">
            <p><span>01</span><%= copy.stepOne %></p>
            <span class="consultation-heading-line"></span>
            <p><span>02</span><%= copy.stepTwo %></p>
          </div>

          <form id="consultationForm" data-sending="<%= copy.sending %>" data-error="<%= copy.errorFallback %>" novalidate>
            <div class="consultation-section-label">
              <span>01</span>
              <h2><%= copy.stepOne %></h2>
            </div>

            <div class="consultation-fields consultation-fields-two">
              <label class="consultation-field">
                <span><%= copy.name %> <b>*</b></span>
                <input name="nama" type="text" autocomplete="name" maxlength="80" placeholder="<%= copy.namePlaceholder %>" required>
              </label>
              <label class="consultation-field">
                <span><%= copy.phone %> <b>*</b></span>
                <input name="no_telp" type="tel" autocomplete="tel" inputmode="tel" maxlength="20" placeholder="<%= copy.phonePlaceholder %>" required>
              </label>
              <label class="consultation-field consultation-field-wide">
                <span><%= copy.email %> <b>*</b></span>
                <input name="email" type="email" autocomplete="email" maxlength="160" placeholder="<%= copy.emailPlaceholder %>" required>
              </label>
            </div>

            <div class="consultation-divider"></div>
            <div class="consultation-section-label">
              <span>02</span>
              <h2><%= copy.stepTwo %></h2>
            </div>

            <div class="consultation-fields consultation-fields-two">
              <label class="consultation-field">
                <span><%= copy.date %></span>
                <input name="wedding_date" type="date">
                <small><%= copy.dateHint %></small>
              </label>
              <label class="consultation-field">
                <span><%= copy.city %></span>
                <input name="wedding_city" type="text" maxlength="100" placeholder="<%= copy.cityPlaceholder %>">
              </label>
              <label class="consultation-field">
                <span><%= copy.venue %></span>
                <input name="venue" type="text" maxlength="120" placeholder="<%= copy.venuePlaceholder %>">
              </label>
              <label class="consultation-field">
                <span><%= copy.guests %></span>
                <select name="guests">
                  <option value=""><%= copy.choose %></option>
                  <% copy.guestsOptions.forEach((option) => { %><option value="<%= option %>"><%= option %></option><% }) %>
                </select>
              </label>
              <label class="consultation-field consultation-field-wide">
                <span><%= copy.budget %></span>
                <select name="budget">
                  <option value=""><%= copy.choose %></option>
                  <% copy.budgetOptions.forEach((option) => { %><option value="<%= option %>"><%= option %></option><% }) %>
                </select>
              </label>
            </div>

            <fieldset class="consultation-services">
              <legend><%= copy.service %></legend>
              <div>
                <% copy.serviceOptions.forEach((option, index) => { %>
                  <label class="consultation-choice">
                    <input type="checkbox" name="services" value="<%= option %>">
                    <span class="consultation-choice-check" aria-hidden="true">
                      <svg viewBox="0 0 16 16" fill="none"><path d="m3.5 8 3 3 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span><%= option %></span>
                  </label>
                <% }) %>
              </div>
            </fieldset>

            <label class="consultation-field consultation-message">
              <span><%= copy.message %> <b>*</b></span>
              <textarea name="message" rows="4" maxlength="1200" placeholder="<%= copy.messagePlaceholder %>" required></textarea>
            </label>

            <div class="consultation-captcha">
              <div>
                <span class="consultation-captcha-label"><%= copy.captcha %></span>
                <p id="consultationCaptchaQuestion"><%= copy.captchaLoading %></p>
              </div>
              <img id="consultationCaptchaCode" class="consultation-captcha-code" alt="<%= copy.captcha %>" width="160" height="48">
              <input id="consultationCaptchaAnswer" name="captcha_answer" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off" aria-label="<%= copy.captcha %>" placeholder="<%= lang === 'en' ? 'Enter code' : 'Ketik di sini' %>" required>
              <input id="consultationCaptchaId" name="captcha_id" type="hidden">
              <button id="consultationCaptchaReload" type="button" aria-label="<%= copy.captchaRetry %>" title="<%= copy.captchaRetry %>">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 7v5h-5M4.6 9a7.5 7.5 0 0 1 12.7-2L20 12M4 17v-5h5m6.8 2a7.5 7.5 0 0 1-12.7 2L4 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>

            <p id="consultationMessage" class="consultation-status" role="status" aria-live="polite" hidden></p>

            <button id="consultationSubmit" class="consultation-submit" type="submit" disabled>
              <span><%= copy.submit %></span>
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <p class="consultation-required-note"><b>*</b> <%= copy.required %></p>
          </form>

        </section>
      </div>

      <p class="consultation-mobile-note"><%= copy.private %></p>
    </main>

    <dialog id="consultationSuccess" class="consultation-success-dialog" aria-labelledby="consultationSuccessTitle" aria-describedby="consultationSuccessText">
      <div class="consultation-success-content">
        <span class="consultation-success-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none"><path d="m5 12 4.5 4.5L19 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h2 id="consultationSuccessTitle"><%= copy.successTitle %></h2>
        <p id="consultationSuccessText"><%= copy.successText %></p>
        <p class="consultation-success-tagline"><strong>Sagita Wedding Planner – <%= copy.successTagline %></strong></p>
        <a id="consultationWhatsappConfirm" class="consultation-success-confirm" href="<%= contactLinks.whatsappShortLink %>" data-whatsapp-message="<%= lang === 'en' ? 'Hello, I’ve submitted the wedding consultation form. I look forward to hearing from your team. Thank you.' : 'Halo, saya sudah mengirim formulir konsultasi pernikahan. Mohon kabari saya jika ada informasi lebih lanjut. Terima kasih.' %>"><%= copy.whatsappConfirm %></a>
      </div>
    </dialog>

    <%- include('../partials/accessibility-widget') %>
    <script src="/js/main.js?v=<%= assetV %>" defer></script>
    <script src="/js/accessibility.js?v=<%= assetV %>-a11y1" defer></script>
    <script src="/js/pages/consultation-form.js?v=<%= assetV %>" defer></script>
  </body>
</html>
