---
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Navbar from "../components/Navbar.astro";
import SitaChat from "../components/SitaChat.astro";
import WhatsappFloat from "../components/WhatsappFloat.astro";

interface Props {
	title?: string;
	metaDescription?: string;
	metaKeywords?: string;
	robots?: string;
	ogImage?: string;
	ogType?: string;
	articleMeta?: {
		headline?: string;
		description?: string;
		image?: string;
		datePublished?: string;
		dateModified?: string;
		section?: string;
	};
	pageSchemaType?: string;
	heroImage?: string;
	breadcrumbs?: { name: string; url?: string }[];
	heroNav?: boolean;
	heroNavLight?: boolean;
	showNavbar?: boolean;
	showFooter?: boolean;
	showContactActions?: boolean;
	htmlClass?: string;
}

const {
	showNavbar = true,
	showFooter = true,
	showContactActions = true,
	htmlClass,
	...headProps
} = Astro.props;
const { lang } = Astro.locals;
const lightHeroNav = headProps.heroNavLight ?? headProps.heroNav;
---

<!doctype html>
<html lang={lang} class={htmlClass}>
	<head>
		<Head {...headProps} />
	</head>
	<body class="site-public">
		<div class="page-loader" role="status" aria-live="polite" aria-atomic="true">
			<span class="page-loader__ring" aria-hidden="true"></span>
			<span class="page-loader__label">{lang === "en" ? "Loading page…" : "Memuat halaman…"}</span>
		</div>
		{showNavbar && <Navbar heroNav={headProps.heroNav} heroNavLight={lightHeroNav} />}
		<slot />
		{showFooter && <Footer />}
		{
			showContactActions && (
				<aside
					class="contact-actions"
					data-contact-actions
					aria-label={lang === "en" ? "Contact options" : "Pilihan kontak"}
				>
					<SitaChat />
					<WhatsappFloat />
				</aside>
			)
		}
		<script>
			import "../lib/browser/telemetry";
			import "../lib/browser/main";
			import "../lib/browser/accessibility";
		</script>
		<AnalyticsConsent />
	</body>
</html>
