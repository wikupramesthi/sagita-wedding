---
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { localizeFaqs } from "../lib/data/faqContent.js";
import { getPageBatch } from "../lib/services/batchService.js";
import type { TestimonialItem } from "../lib/types/index.js";

const { contactLinks, lang } = Astro.locals;
const isID = lang === "id";
const txt = (id: string, en: string) => (isID ? id : en);
const title = "Pernikahan Digital - Our Wedding Link";
const metaDescription =
	"Undangan digital, buku tamu digital, dan RSVP dalam satu platform. Pilih dari 95+ desain, sebar ke tamu, lalu sambut mereka di hari H. Daftar gratis.";

const steps = [
	[
		"01",
		txt("Ceritakan rencanamu", "Tell us your plan"),
		txt(
			"Tanggal, lokasi, dan perkiraan tamu jadi patokan awal.",
			"Date, venue, and guest count set the starting point.",
		),
	],
	[
		"02",
		txt("Pilih paket", "Pick a package"),
		txt(
			"Bandingkan harga dan fitur, lalu pilih yang paling pas.",
			"Compare prices and features, then choose your fit.",
		),
	],
	[
		"03",
		txt("Konsultasi detail", "Refine the details"),
		txt(
			"Tim membantu menyesuaikan opsi dan kebutuhan acaramu.",
			"Our team helps tailor options to your celebration.",
		),
	],
	[
		"04",
		txt("Siap hari H", "Enjoy your day"),
		txt(
			"Semua detail tertata supaya kamu bisa fokus menikmati acara.",
			"Every detail is set so you can enjoy the day.",
		),
	],
];
const stepLabels = [
	txt("MULAI DARI RENCANA", "START WITH A PLAN"),
	txt("PILIH YANG SESUAI", "FIND YOUR FIT"),
	txt("RAPIKAN DETAIL", "REFINE THE DETAILS"),
	txt("NIKMATI HARI BAHAGIA", "ENJOY YOUR DAY"),
];
const stepIcons = ["chat", "search", "check", "spark"];

const [paketData, faqData, homeData] = await Promise.all([
	getPageBatch("packages", { per_page: 10 }).catch(() => null),
	getPageBatch("faq").catch(() => null),
	getPageBatch("home").catch(() => null),
]);
const faqItems = localizeFaqs(faqData?.faqs, lang === "id" ? "id" : "en")
	.flatMap((item) => {
		if (!item || typeof item !== "object" || Array.isArray(item)) return [];
		const faq = item as Record<string, unknown>;
		const question = String(faq.question ?? "").trim();
		const answer = String(faq.answer ?? "").trim();
		return question && answer ? [{ question, answer }] : [];
	})
	.slice(0, 6);
const testimonials =
	homeData?.weddingContentReady === true && Array.isArray(homeData.testimonials)
		? (homeData.testimonials as TestimonialItem[]).slice(0, 16)
		: [];
const posterAspectRatios = ["3 / 4", "4 / 5", "2 / 3", "1 / 1"];
const testimonialCards = testimonials.map((testimonial, index) => {
	const foto = String(testimonial.foto || "");
	const photo =
		foto && !/\/images\/default\.png(?:[?#]|$)/i.test(foto) ? foto : "";
	const initials = String(testimonial.nama || "?")
		.trim()
		.split(/\s+/)
		.slice(0, 2)
		.map((part) => part.charAt(0))
		.join("")
		.toUpperCase();

	return {
		nama: testimonial.nama || "",
		jabatan: testimonial.jabatan?.trim() || "",
		isi_testimoni: testimonial.isi_testimoni || "",
		photo,
		initials,
		aspectRatio: posterAspectRatios[index % posterAspectRatios.length],
	};
});
const paketPopuler = (pkg: any) =>
	pkg?.is_popular === true || pkg?.is_popular === 1 || pkg?.is_popular === "1";
const paketList = Array.isArray(paketData?.packages)
	? [...paketData.packages]
	: [];
const indeksRekomendasi = paketList.findIndex(paketPopuler);
if (indeksRekomendasi >= 0) {
	const tengah = Math.floor(paketList.length / 2);
	if (indeksRekomendasi !== tengah) {
		const [rekomendasi] = paketList.splice(indeksRekomendasi, 1);
		paketList.splice(tengah, 0, rekomendasi);
	}
}
const rupiah = (value: unknown) =>
	new Intl.NumberFormat("id-ID").format(Number(value || 0));
const bersihkanTeks = (value: unknown) =>
	typeof value === "string"
		? value
				.replace(/<[^>]*>/g, " ")
				.replace(/\s+/g, " ")
				.trim()
		: "";
const opsiPaket = (pkg: any) =>
	(Array.isArray(pkg?.options) ? pkg.options : [])
		.map((option: any) => ({
			...option,
			akhir: Number(option.final_price ?? option.price ?? 0),
			normal: Number(option.price ?? 0),
		}))
		.filter((option: any) => option.akhir > 0)
		.sort((a: any, b: any) => a.akhir - b.akhir);
const fiturPaket = (pkg: any) =>
	(Array.isArray(pkg?.features) ? pkg.features : [])
		.map((feature: any) =>
			typeof feature === "string"
				? feature
				: String(feature?.feature || feature?.name || ""),
		)
		.filter(Boolean)
		.slice(0, 4);
---
<BaseLayout title={title} metaDescription={metaDescription} heroNav={true} heroNavLight={true} htmlClass="sw-lp-html sw-lp-js">
	<style is:inline>
