ing="async"></div><div class="sw-desain-kartu__meta"><span class="sw-desain-kartu__nama">Beautifull Green</span><span class="sw-desain-kartu__paket">Paket Eksklusif</span></div></a><a href="#" data-gaya="minimalis floral" aria-hidden="true" tabindex="-1" class="sw-desain-kartu"><div class="sw-desain-kartu__gbr"><img src="/img/portofolio/landing/img/desain/calm-blue.webp" width="560" height="396" alt="" loading="lazy" decoding="async"></div><div class="sw-desain-kartu__meta"><span class="sw-desain-kartu__nama">Calm Blue</span><span class="sw-desain-kartu__paket">Paket Eksklusif</span></div></a><a href="#" data-gaya="animasi dark minimalis" aria-hidden="true" tabindex="-1" class="sw-desain-kartu"><div class="sw-desain-kartu__gbr"><img src="/img/portofolio/landing/img/desain/auto-scrolled-cinematic.webp" width="560" height="396" alt="" loading="lazy" decoding="async"></div><div class="sw-desain-kartu__meta"><span class="sw-desain-kartu__nama">Auto Scrolled Cinematic</span><span class="sw-desain-kartu__paket">Desain Luxury</span></div></a><a href="#" data-gaya="minimalis animasi" aria-hidden="true" tabindex="-1" class="sw-desain-kartu"><div class="sw-desain-kartu__gbr"><img src="/img/portofolio/landing/img/desain/milenial-template.webp" width="560" height="396" alt="" loading="lazy" decoding="async"></div><div class="sw-desain-kartu__meta"><span class="sw-desain-kartu__nama">SnowFall Minimalist</span><span class="sw-desain-kartu__paket">Desain Luxury</span></div></a><a href="#" data-gaya="game adat" aria-hidden="true" tabindex="-1" class="sw-desain-kartu"><div class="sw-desain-kartu__gbr"><img src="/img/portofolio/landing/img/desain/javanese-game.webp" width="560" height="396" alt="" loading="lazy" decoding="async"></div><div class="sw-desain-kartu__meta"><span class="sw-desain-kartu__nama">Javanese Game</span><span class="sw-desain-kartu__paket">Paket Eksklusif</span></div></a><a href="#" data-gaya="game animasi" aria-hidden="true" tabindex="-1" class="sw-desain-kartu"><div class="sw-desain-kartu__gbr"><img src="/img/portofolio/landing/img/desain/pixel-game-world.webp" width="560" height="396" alt="" loading="lazy" decoding="async"></div><div class="sw-desain-kartu__meta"><span class="sw-desain-kartu__nama">Pixel Game World</span><span class="sw-desain-kartu__paket">Paket Eksklusif</span></div></a><a href="#" data-gaya="game floral" aria-hidden="true" tabindex="-1" class="sw-desain-kartu"><div class="sw-desain-kartu__gbr"><img src="/img/portofolio/landing/img/desain/minimalist-el-gaga.webp" width="560" height="396" alt="" loading="lazy" decoding="async"></div><div class="sw-desain-kartu__meta"><span class="sw-desain-kartu__nama">Playful Playdate</span><span class="sw-desain-kartu__paket">Paket Eksklusif</span></div></a><a href="#" data-gaya="adat elegan" aria-hidden="true" tabindex="-1" class="sw-desain-kartu"><div class="sw-desain-kartu__gbr"><img src="/img/portofolio/landing/img/desain/chinese-red.webp" width="560" height="396" alt="" loading="lazy" decoding="async"></div><div class="sw-desain-kartu__meta"><span class="sw-desain-kartu__nama">Chinese Red</span><span class="sw-desain-kartu__paket">Paket Premium</span></div></a><a href="#" data-gaya="adat elegan dark" aria-hidden="true" tabindex="-1" class="sw-desain-kartu"><div class="sw-desain-kartu__gbr"><img src="/img/portofolio/landing/img/desain/gold-batik.webp" width="560" height="396" alt="" loading="lazy" decoding="async"></div><div class="sw-desain-kartu__meta"><span class="sw-desain-kartu__nama">Gold Batik</span><span class="sw-desain-kartu__paket">Paket Premium</span></div></a></div></div> <div class="sw-rel__kaki"><a data-tautan-katalog href="#" class="sw-tautan-panah">Lihat semua desain <svg aria-hidden="true" class="sw-ikon"><use href="#sw-i-arrow-up-right"></use></svg></a> <button type="button" data-jeda=".sw-marquee--katalog" aria-pressed="false" aria-label="Jeda gerakan desain" data-aria-lanjut="Lanjutkan gerakan desain" class="sw-bukti__jeda"><svg aria-hidden="true" class="sw-ikon"><use href="#sw-i-pause"></use></svg></button></div></div></section>  <section id="sw-tamu" aria-labelledby="sw-judul-tamu" class="sw-sec sw-motif sw-berhias"><div class="sw-wrap sw-fitur-blok sw-fitur-blok--balik"><div data-muncul class="sw-fitur-blok__teks"><h2 id="sw-judul-tamu">Sebar ke tamu <span class="sw-t-script">tanpa batas</span></h2> <p class="sw-lp-lead">Bagikan undangan ke tamu sebanyak apa pun lewat WhatsApp, link, atau QR. Mulai paket Premium, tamu juga bisa mendapat link dengan namanya sendiri: sampai 100 tamu di Premium, tanpa batas di Eksklusif ke atas.</p> <ul class="sw-bersih sw-poin"><li><span class="sw-poin__ikon"><svg aria-hidden="true" class="sw-ikon"><use href="#sw-i-share-network"></use></svg></span><div><h3>Bagikan dengan cara apa pun</h3><p>Salin link, tunjukkan QR, kirim tanpa nama atau dengan nama tamu, atau unggah undangan gambar ke story.</p><span class="sw-label-paket">Undangan gambar: Eksklusif ke atas</span></div></li><li><span class="sw-poin__ikon"><svg aria-hidden="true" class="sw-ikon"><use href="#sw-i-users-three"></use></svg></span><div><h3>Link bernama untuk tiap tamu</h3><p>Nama tamu tampil di sampul undangan. Tanpa batas jumlah tamu di paket Eksklusif ke atas.</p><span class="sw-label-paket">Premium sampai 100 tamu</span></div></li><li><span class="sw-poin__ikon"><svg aria-hidden="true" class="sw-ikon"><use href="#sw-i-paper-plane-tilt"></use></svg></span><div><h3>Kirim massal lewat WhatsApp</h3><p>Pilih banyak tamu sekaligus, atur jam kirimnya, lalu kirim pengingat ke tamu yang belum konfirmasi.</p><span class="sw-label-paket">Premium ke atas</span></div></li><li><span class="sw-poin__ikon"><svg aria-hidden="true" class="sw-ikon"><use href="#sw-i-file-xls"></use></svg></span><div><h3>Import dari Excel</h3><p>Punya daftar tamu di Excel? Unggah sekali, semua nama langsung masuk.</p><span class="sw-label-paket">Premium ke atas</span></div></li><li><span class="sw-poin__ikon"><svg aria-hidden="true" class="sw-ikon"><use href="#sw-i-lock-key"></use></svg></span><div><h3>Tamu private dan versi undangan</h3><p>Undangan hanya terbuka untuk tamu terdaftar, dan tiap kelompok tamu bisa menerima versi undangannya sendiri.</p><span class="sw-label-paket">Premium ke atas; kode akses dan versi: Luxury</span></div></li></ul></div> <div class="sw-komposit sw-komposit--tamu"><div aria-hidden="true" class="sw-kp-panggung"><img src="/img/portofolio/landing/img/hiasan/mawar-sudut-kiri.webp" width="820" height="451" alt="" aria-hidden="true" loading="lazy" decoding="async" class="sw-kp-bunga sw-kp-bunga--kiri" style="--w:40;--wm:50"></div> <figure class="sw-kp-dasar" style="--x:18;--y:20;--w:82;--xm:0;--ym:31;--wm:100"><img loading="lazy" decoding="async" alt="Layar asli Daftar tamu di dasbor desktop: tipe tamu, jumlah, meja, dan status kartu QR serta kehadiran." src="/img/portofolio/landing/screens/dk-tamu.webp" width="1600" height="1000"></figure> <div aria-hidden="true" class="sw-kp-kartu sw-kp-wa" style="--x:0;--y:0;--w:42;--xm:26;--ym:0;--wm:74"><span class="sw-kp-wa__dari">Laras &amp; Bima</span> <p>Kepada Yth. <b>Bpk. Hartono &amp; keluarga</b>, dengan penuh syukur kami mengundang Bapak sekeluarga ke hari bahagia kami.</p> <span class="sw-kp-wa__link">our-wedding.link/laras-bima<small>Undangan untuk Bpk. Hartono</small></span> <span class="sw-kp-wa__jam">09.12 <svg viewBox="0 0 18 10"><path d="M1 5l3 3 6-7M7 8l1 0 7-7"></path></svg></span></div> <figure class="sw-kp-kartu" style="--x:60;--y:57;--w:38;--xm:48;--ym:80;--wm:52"><img loading="lazy" decoding="async" alt="Potongan layar asli Bagikan undangan: kirim tanpa nama, dengan nama tamu, Broadcast WhatsApp, dan undangan gambar." src="/img/portofolio/landing/screens/sorot/kirim.webp" width="568" height="564"></figure></div></div></section>  <section id="sw-buku-tamu" aria-labelledby="sw-judul-bt" class="sw-sec sw-bt sw-berhias"><img src="/img/portofolio/landing/img/hiasan/wisteria-juntai-kiri.webp" width="700" height="681" alt="" aria-hidden="true" loading="lazy" decoding="async" class="sw-hiasan sw-hiasan--kiri-atas"><img src="/img/portofolio/landing/img/hiasan/wisteria-juntai-kanan.webp" width="700" height="681" alt="" aria-hidden="true" loading="lazy" decoding="async" class="sw-hiasan sw-hiasan--kanan-atas sw-hiasan--bt"> <div class="sw-wrap"><div data-muncul class="sw-kepala sw-kepala--tengah"><span class="sw-alis">Koordinasi Tamu Hari H</span> <h2 id="sw-judul-bt">Hari H <span class="sw-t-script">lebih tenang,</span> semua <span class="sw-t-bold">terkoordinasi</span></h2> <p class="sw-lp-lead">Tim wedding organizer kami mengatur alur kedatangan, penyambutan, souvenir, hingga hadiah. Semua terhubung dengan undangan dan daftar tamu Anda.</p></div> <ol data-muncul class="sw-bersih sw-bt__alur"><li><b>Kedatangan tamu tercatat</b><span>Tamu menunjukkan QR dari undangan digital atau kartu undangannya.</span></li> <li><b>Tim WO memindai QR</b><span>Kedatangan dicatat lewat aplikasi, atau tamu check-in secara mandiri.</span></li> <li><b>Sambutan terasa personal</b><span>Nama tamu tampil di layar sapa saat tiba di venue.</span></li> <li><b>Souvenir dibagikan tertib</b><span>Struk kedatangan tercetak; informasi meja dan menu mudah diakses.</span></li> <li><b>Rekap acara lebih mudah</b><span>Data kehadiran, hadiah, dan selfie check-in dapat diunduh ke Excel.</span></li></ol> <div class="sw-bt__panggung"><figure data-muncul class="sw-monitor"><div class="sw-monitor__layar"><img src="/img/portofolio/landing/screens/dk-layarsapa.webp" width="1600" height="900" loading="lazy" decoding="async" alt="Layar asli layar sapa di monitor venue: foto pasangan, nama Laras dan Bima, tanggal acara, dan daftar tamu yang baru datang."></div> <div aria-hidden="true" class="sw-monitor__kaki"></div> <figcaption class="sw-cap">Layar sapa asli dengan foto dan nama contoh. Nama tamu disamarkan.</figcaption></figure> <div data-muncul class="sw-bt__samping"><figure class="sw-hp sw-hp--app"><img src="/img/portofolio/landing/screens/gb-app-layar.webp" width="339" height="717" loading="lazy" decoding="async" alt="Aplikasi penerima tamu di HP: total tamu, belum check-in, tamu di venue, dan daftar semua tamu."></figure> <p class="sw-cap">Aplikasi penerima tamu untuk kru di pintu masuk.</p></div></div>  <div class="sw-bt__laporan"><div class="sw-bt__laporan-teks"><span class="sw-alis">Layanan wedding organizer</span> <h3 class="sw-bt__laporan-judul">Persiapan <span class="sw-t-script">lebih terarah</span> hari H <span class="sw-t-bold">lebih tenang</span></h3> <p>Kami bantu merencanakan acara dan mengoordinasikan persiapan, dari sebelum hari H sampai acara selesai. Kamu bisa fokus menikmati momen bersama keluarga.</p> <ul class="sw-bersih sw-bt__laporan-poin"><li>Membahas konsep dan kebutuhan acara</li> <li>Menyusun susunan acara bersama keluarga</li> <li>Berkoordinasi dengan vendor dan venue</li> <li>Menyiapkan kebutuhan sebelum hari H</li> <li>Mendampingi jalannya acara di hari H</li></ul></div> <blockquote class="tiktok-embed" cite="https://www.tiktok.com/@sagitaweddingplan" data-unique-id="sagitaweddingplan" data-embed-from="embed_page" data-embed-type="creator" style="max-width:780px; min-width:288px;"> <section> <a target="_blank" href="https://www.tiktok.com/@sagitaweddingplan?refer=creator_embed">@sagitaweddingplan</a> </section> </blockquote> <script is:inline async src="https://www.tiktok.com/embed.js"></script></div> </div></section> <section id="sw-harga" aria-labelledby="sw-judul-harga" class="sw-sec sw-motif sw-berhias"><div class="sw-wrap"><div data-muncul class="sw-kepala"><span class="sw-alis">Paket wedding organizer</span> <h2 id="sw-judul-harga">Harga <span class="sw-utuh"><span class="sw-t-script">bersahabat</span>,</span> layanan dan konsep <span class="sw-t-bold">paling lengkap!</span></h2> <p class="sw-lp-lead">Konsultasikan rencana pernikahanmu tanpa bayar. Pilih paket wedding organizer setelah detail acara matang, lalu sesuaikan layanan kapan saja bersama tim kami.</p> </div>  <div class="sw-harga">{paketList.length ? paketList.map((pkg: any) => {
	const opsi = opsiPaket(pkg);
	const mulai = opsi[0];
	const fitur = fiturPaket(pkg);
	return (
		<article data-muncul class:list={["sw-paket", paketPopuler(pkg) ? "sw-paket--saran" : ""]}>
			<div class="sw-paket__atas"><h3 class="sw-paket__nama">{pkg.name}</h3>{paketPopuler(pkg) && <span class="sw-paket__lencana">Rekomendasi</span>}</div>
			{bersihkanTeks(pkg.description) && <p class="sw-paket__tag">{bersihkanTeks(pkg.description)}</p>}
			<div class="sw-paket__harga">{mulai ? <><span class="sw-paket__rp">Rp{rupiah(mulai.akhir)}</span>{mulai.normal > mulai.akhir && <span class="sw-paket__coret"><span class="sw-sr-only">Harga normal </span>Rp{rupiah(mulai.normal)}</span>}<span class="sw-sr-only">Mulai dari {mulai.name}</span></> : <span class="sw-paket__rp">Hubungi kami</span>}</div>
			<ul class="sw-bersih sw-paket__fitur">{fitur.map((item: string) => <li><svg aria-hidden="true" class="sw-ikon"><use href="#sw-i-check"></use></svg><span>{item}</span></li>)}</ul>
		</article>
	);
}) : <p class="sw-harga__kosong">Paket belum tersedia.</p>}</div> <div class="sw-harga__kaki"><p class="sw-kecil">Harga mengikuti opsi yang aktif pada tiap paket. Detail layanan, jadwal, dan penyesuaian bisa didiskusikan bersama tim kami.</p> <a href="/formulir-konsultasi" class="sw-tbl sw-tbl--utama">Konsultasi paket<span class="sw-tbl__ikon"><svg aria-hidden="true" class="sw-ikon"><use href="#sw-i-arrow-up-right"></use></svg></span></a></div></div></section> <section aria-labelledby="sw-judul-testi" class="sw-sec sw-sec--blush sw-berhias"><div class="sw-wrap"><div data-muncul class="sw-kepala sw-kepala--tengah"><h2 id="sw-judul-testi">Momen <span class="sw-t-script">Spesial</span> Cerita <span class="sw-t-bold">Tak Terlupakan</span></h2> <img src="/img/portofolio/landing/img/hiasan/untaian-mawar-pemisah.webp" width="900" height="125" alt="" aria-hidden="true" loading="lazy" decoding="async" class="sw-pemisah-bunga sw-pemisah-bunga--tengah"> </div> {testimonialCards.length > 0 && (
			<div class="sw-poster-grid">
				{testimonialCards.map((card) => (
					<article data-muncul class="sw-poster" style={`--ar:${card.aspectRatio};`}>
						{card.photo ? (
							<img src={card.photo} alt="" loading="lazy" decoding="async" width="480" height="600">
						) : (
							<span aria-hidden="true" style={`aspect-ratio:${card.aspectRatio};display:grid;place-items:center;font-size:2rem;color:rgba(255,255,255,.82);`}>
								{card.initials}
							</span>
						)}
						<div class="sw-poster__isi">
							<span class="sw-poster__nama">{card.nama}</span>
							<q class="sw-poster__kutip">{card.isi_testimoni}</q>
							<span class="sw-poster__kaki">
