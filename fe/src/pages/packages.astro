---
import HomeFaqSection from "../components/HomeFaqSection.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getHomeFaqs } from "../lib/data/faqContent.js";
import { getPageBatch } from "../lib/services/batchService.js";
import { cleanPage, cleanText } from "../lib/utils/validate.js";

const { lang, t, contactLinks } = Astro.locals;
const isID = lang === "id";
const txt = (id: string, en: string) => (isID ? id : en);
const waLink = contactLinks.whatsappLink || "#";
const money = (value: unknown) =>
	new Intl.NumberFormat("id-ID").format(Number(value || 0));

function readText(value: unknown, max: number, label: string): string {
	try {
		return cleanText(value, { max, label });
	} catch {
		return "";
	}
}

const rawFilter = readText(Astro.url.searchParams.get("filter"), 40, "Filter");
const rawSort = readText(Astro.url.searchParams.get("sort"), 40, "Sort");
const params = {
	search: readText(Astro.url.searchParams.get("search"), 80, "Search"),
	filter: ["popular", "unlimited"].includes(rawFilter) ? rawFilter : "",
	sort: ["popular", "lowest_price"].includes(rawSort) ? rawSort : "",
	page: cleanPage(Astro.url.searchParams.get("page")),
	per_page: 10,
};
const [data, faqData] = await Promise.all([
	getPageBatch("packages", params),
	getPageBatch("faq").catch(() => null),
]);
const items = Array.isArray(data?.packages) ? data.packages : [];
const isPopularPackage = (pkg: any) =>
	pkg?.is_popular === true || pkg?.is_popular === 1 || pkg?.is_popular === "1";
const displayItems = [...items];
const popularIndex = displayItems.findIndex(isPopularPackage);
const recommendedIndex = Math.floor(displayItems.length / 2);
if (popularIndex >= 0 && popularIndex !== recommendedIndex) {
	const [recommendedPackage] = displayItems.splice(popularIndex, 1);
	displayItems.splice(recommendedIndex, 0, recommendedPackage);
}
const packageFaqGroups = getHomeFaqs(faqData?.faqs, lang);
const meta = data?.meta || {};
const search = params.search;
const filter = params.filter;
const sort = params.sort;
const totalPackages = Number(meta.total) || items.length;
const currentPage = Number(meta.current_page) || params.page;
const totalPages = Number(meta.last_page) || 1;
const error: string | null = null;

const pkgFilterHref = (value: string) => {
	const q = new URLSearchParams();
	if (search) q.set("search", search);
	if (sort) q.set("sort", sort);
	if (value) q.set("filter", value);
	const query = q.toString();
	return `/packages${query ? `?${query}` : ""}`;
};
const pkgQ = new URLSearchParams();
if (search) pkgQ.set("search", search);
if (filter) pkgQ.set("filter", filter);
if (sort) pkgQ.set("sort", sort);
const pkgQuery = pkgQ.toString();
const pkgHref = (n: number) =>
	`/packages${pkgQuery ? `?${pkgQuery}&page=${n}` : `?page=${n}`}`;

const featureLabel = (feature: unknown) =>
	typeof feature === "string"
		? feature
		: feature && typeof feature === "object" && "feature" in feature
			? String((feature as { feature?: unknown }).feature ?? "")
			: "";

const steps = [
	[
		"01",
		txt("Ceritakan rencanamu", "Tell us your plan"),
		txt(
			"Tanggal, lokasi, dan perkiraan tamu jadi patokan awal.",
			"Date, venue, and guest count set the starting point.",
		),
	],
	[
		"02",
		txt("Pilih paket", "Pick a package"),
		txt(
			"Bandingkan harga dan fitur, lalu pilih yang paling pas.",
			"Compare prices and features, then choose your fit.",
		),
	],
	[
		"03",
		txt("Konsultasi detail", "Refine the details"),
		txt(
			"Tim membantu menyesuaikan opsi dan kebutuhan acaramu.",
			"Our team helps tailor options to your celebration.",
		),
	],
	[
		"04",
		txt("Siap hari H", "Enjoy your day"),
		txt(
			"Semua detail tertata supaya kamu bisa fokus menikmati acara.",
			"Every detail is set so you can enjoy the day.",
		),
	],
];
const stepLabels = [
	txt("MULAI DARI RENCANA", "START WITH A PLAN"),
	txt("PILIH YANG SESUAI", "FIND YOUR FIT"),
	txt("RAPIKAN DETAIL", "REFINE THE DETAILS"),
	txt("NIKMATI HARI BAHAGIA", "ENJOY YOUR DAY"),
];
const stepIcons = ["chat", "search", "check", "spark"];
const packageGuidanceItems = [
	{
		icon: "wallet",
		title: txt("Harga paket", "Package price"),
		description: txt(
			"Harga final mengikuti opsi aktif pada paket yang dipilih.",
			"Final price follows the active options on your chosen package.",
		),
	},
	{
		icon: "clock",
		title: txt("Durasi layanan", "Service duration"),
		description: txt(
			"Durasi menyesuaikan paket dan opsi yang kamu ambil.",
			"Duration follows the package and options you select.",
		),
	},
	{
		icon: "map-pin",
		title: txt("Area acara", "Event area"),
		description: txt(
			"Lokasi dan penjadwalan dibahas bersama tim saat konsultasi.",
			"Location and scheduling are discussed with our team.",
		),
	},
	{
		icon: "spark",
		title: txt("Perubahan paket", "Package changes"),
		description: txt(
			"Kamu bisa mendiskusikan penyesuaian sebelum memesan.",
			"You can discuss adjustments before placing an order.",
		),
	},
];
---

<BaseLayout
	title={isID
		? "Paket Pernikahan | Sagita Wedding Planner"
		: "Wedding Planning Packages | Sagita Wedding Planner"}
	metaDescription={isID
		? "Jelajahi paket pernikahan Sagita Wedding Planner dan temukan layanan yang sesuai dengan rencana, kebutuhan, dan hari istimewa Anda."
		: "Explore Sagita Wedding Planner packages and find wedding planning services that fit your plans, priorities, and celebration."}
	heroNav={true}
>
	<main id="isi" class="antialiased bg-sand-50">
		<section class="relative overflow-hidden text-sand-50">
			<div
				class="absolute inset-0"
				style="background:
				  radial-gradient(ellipse 60% 50% at 12% 8%, rgba(183, 159, 128, 0.28) 0%, transparent 60%),
				  radial-gradient(ellipse 50% 60% at 90% 100%, var(--color-sand-900) 0%, transparent 70%),
				  linear-gradient(135deg, var(--color-sand-700) 0%, var(--color-sand-800) 55%, var(--color-sand-900) 100%)"
				aria-hidden="true"
			></div>
			<div
				class="absolute inset-0 opacity-[0.06] mix-blend-overlay pointer-events-none"
				style="background-image:url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' fill='white'/%3E%3C/svg%3E&quot;)"
				aria-hidden="true"
			></div>
			<div class="hero-shimmer"></div>

			<div class="site-container relative z-10 pb-28 pt-28 text-center sm:pb-32 sm:pt-32">
				<span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-4 py-1.5 text-[11px] font-medium uppercase tracking-[0.18em] text-sand-100 backdrop-blur-sm anim-fade-in">
					<span class="h-1.5 w-1.5 rounded-full bg-gold-light"></span>
					Sagita Wedding Planner
				</span>

				<h1 class="mt-6 font-display text-4xl leading-[1.08] tracking-tight anim-slide-up sm:text-5xl lg:text-6xl">
					<span class="block">{t.packagesTitleA}</span>
					<span class="block font-light italic text-gold-light">{t.packagesTitleB}</span>
				</h1>

				<p class="mx-auto mt-5 max-w-xl text-sm leading-relaxed text-sand-100/80 anim-fade-in sm:text-base" style="animation-delay:.3s">
					{t.packagesDesc}
				</p>

				<div class="mt-8 flex flex-wrap items-center justify-center gap-3 anim-fade-in" style="animation-delay:.42s">
					<a
						href="#daftar-paket"
						class="inline-flex items-center gap-2 rounded-full bg-sand-50 px-6 py-3 text-sm font-semibold text-sand-900 transition hover:bg-white"
					>
						{txt("Lihat daftar paket", "Explore packages")}
						<Icon name="arrow" size="h-4 w-4" />
					</a>
					<a
						href={waLink}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-flex items-center gap-2 rounded-full border border-white/25 bg-white/5 px-6 py-3 text-sm font-semibold text-sand-50 transition hover:bg-white/10"
					>
						<Icon name="whatsapp" size="h-4 w-4" />
						{txt("Tanya via WhatsApp", "Ask on WhatsApp")}
					</a>
				</div>

			</div>
			<div class="pointer-events-none absolute inset-x-0 bottom-0 h-20" style="z-index:0;background:linear-gradient(to top, #fffefd, transparent)" aria-hidden="true"></div>
		</section>

		<section class="package-filter-section relative z-10 -mt-20">
			<div class="site-container">
			<form action="/packages" method="GET" class="package-filter-form rounded-2xl border border-stone-200 bg-white shadow-sm">
				<div class="package-filter-grid grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-12">
					<div class="relative sm:col-span-2 lg:col-span-5">
						<span class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4 text-stone-400">
							<Icon name="search" size="h-[18px] w-[18px]" />
						</span>
						<input
							type="text"
							name="search"
							value={search || ""}
							placeholder={t.packagesSearchPlaceholder}
							aria-label={txt("Cari paket", "Search packages")}
							class="package-filter-control h-11 w-full rounded-xl border border-stone-200 bg-white pl-11 pr-4 text-sm text-stone-700 outline-none transition focus:border-sage-500 focus:ring-2 focus:ring-sage-200 lg:h-9"
						/>
					</div>

					<div class="lg:col-span-3">
						<select
							name="filter"
							aria-label={txt("Filter paket", "Filter packages")}
							class="package-filter-control h-11 w-full rounded-xl border border-stone-200 bg-white px-4 text-sm text-stone-700 outline-none transition focus:border-sage-500 focus:ring-2 focus:ring-sage-200 lg:h-9"
						>
							<option value="">{txt("Semua paket", "All packages")}</option>
							<option value="popular" selected={filter === "popular"}>{txt("Populer", "Popular")}</option>
							<option value="unlimited" selected={filter === "unlimited"}>
								{txt("Tamu tak terbatas", "Unlimited guests")}
							</option>
						</select>
					</div>

					<div class="lg:col-span-2">
						<select
							name="sort"
							aria-label={txt("Urutkan paket", "Sort packages")}
							class="package-filter-control h-11 w-full rounded-xl border border-stone-200 bg-white px-4 text-sm text-stone-700 outline-none transition focus:border-sage-500 focus:ring-2 focus:ring-sage-200 lg:h-9"
						>
							<option value="">{txt("Default", "Default")}</option>
							<option value="popular" selected={sort === "popular"}>{txt("Populer", "Popular")}</option>
							<option value="lowest_price" selected={sort === "lowest_price"}>
								{txt("Harga terendah", "Lowest price")}
							</option>
						</select>
					</div>

					<div class="flex gap-2 sm:col-span-2 lg:col-span-2">
						<button type="submit" class="package-filter-control h-11 flex-1 rounded-xl bg-sage-700 text-sm font-semibold text-white transition hover:bg-sage-800 lg:h-9">
							{txt("Cari", "Search")}
						</button>
						{
							(search || filter || sort) && (
								<a
									href="/packages"
									aria-label={txt("Reset filter", "Reset filters")}
									class="package-filter-control flex h-11 w-11 items-center justify-center rounded-xl border border-stone-200 text-stone-500 transition hover:bg-sand-100 lg:h-9 lg:w-9"
								>
									<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
										<line x1="18" y1="6" x2="6" y2="18"></line>
										<line x1="6" y1="6" x2="18" y2="18"></line>
									</svg>
								</a>
							)
						}
					</div>
				</div>

				<div class="package-filter-quick-links mt-2.5 flex flex-wrap items-center gap-1.5 border-t border-stone-100 pt-2.5">
					<span class="mr-1 text-[11px] text-stone-400">{txt("Jelajahi", "Browse by")}</span>
					<a
						href={pkgFilterHref("")}
						class={`rounded-full px-3 py-1.5 text-[11px] font-semibold transition ${!filter ? "bg-sage-700 text-white" : "border border-stone-200 bg-white text-stone-600 hover:bg-sand-100"}`}
					>
						{txt("Semua", "All")}
					</a>
					<a
						href={pkgFilterHref("popular")}
						class={`rounded-full px-3 py-1.5 text-[11px] font-semibold transition ${filter === "popular" ? "bg-sage-700 text-white" : "border border-stone-200 bg-white text-stone-600 hover:bg-sand-100"}`}
					>
						{txt("Populer", "Popular")}
					</a>
					<a
						href={pkgFilterHref("unlimited")}
						class={`rounded-full px-3 py-1.5 text-[11px] font-semibold transition ${filter === "unlimited" ? "bg-sage-700 text-white" : "border border-stone-200 bg-white text-stone-600 hover:bg-sand-100"}`}
					>
						{txt("Tak terbatas", "Unlimited")}
					</a>
				</div>
			</form>
			</div>
		</section>

		<section id="daftar-paket" class="package-catalog-section site-section">
			<div class="site-container">
			<div class="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="text-xs font-bold uppercase tracking-[0.22em] text-terracotta-600">
						{txt("Daftar harga", "Price list")}
					</p>
					<h2 class="mt-2 font-display text-3xl font-bold text-sage-900 sm:text-4xl">
						{txt("Satu daftar harga, tanpa biaya tersembunyi", "One clear price list, no hidden fees")}
					</h2>
				</div>
				<p class="package-count">
					<span class="package-count__value">{Number(totalPackages) || items.length}</span>
					<span>{txt("paket tersedia", "packages available")}</span>
				</p>
			</div>

			{
				error && (
					<div class="mb-6 flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600">
						<Icon name="shield" size="h-4 w-4" />
						<span>{error}</span>
					</div>
				)
			}

			{
				items.length > 0 ? (
					<div
						class:list={[
							"package-card-grid grid grid-cols-1 items-stretch gap-5 md:grid-cols-2 xl:gap-6",
							items.length >= 4 ? "xl:grid-cols-4" : items.length === 3 ? "xl:grid-cols-3" : items.length === 2 ? "xl:grid-cols-2" : "mx-auto max-w-md xl:grid-cols-1",
						]}
					>
						{displayItems.map((pkg: any) => {
							const options = Array.isArray(pkg.options) ? pkg.options : [];
							const features = Array.isArray(pkg.features) ? pkg.features : [];
							const addons = Array.isArray(pkg.addons) ? pkg.addons : [];
							const isPopular = isPopularPackage(pkg);
							const hasCover = typeof pkg.cover_url === "string" && pkg.cover_url.length > 0;
							const pricedOptions = options
								.map((option: any) => ({
									...option,
									finalPriceValue: Number(option.final_price ?? option.price ?? 0),
									normalPriceValue: Number(option.price ?? 0),
								}))
								.filter((option: any) => option.finalPriceValue > 0)
								.sort((a: any, b: any) => a.finalPriceValue - b.finalPriceValue);
							const startingOption = pricedOptions[0] || null;
							const discountPercent =
								startingOption && startingOption.normalPriceValue > startingOption.finalPriceValue
									? Math.round(
											((startingOption.normalPriceValue - startingOption.finalPriceValue) /
												startingOption.normalPriceValue) *
												100,
										)
									: 0;
							const visibleFeatures = features.slice(0, 5);
							const extraFeatures = features.slice(5);

							return (
								<article
									class:list={[
										"package-price-card group relative flex h-full min-w-0 flex-col overflow-visible rounded-[24px] border text-sage-900 transition duration-300 hover:-translate-y-1",
										isPopular ? "package-price-card--featured" : "",
									]}
								>
									{isPopular && (
										<span class="package-price-card__badge absolute -top-3 left-1/2 z-20 inline-flex -translate-x-1/2 items-center whitespace-nowrap rounded-full px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-white shadow-sm">
											{txt("Rekomendasi", "Recommended")}
										</span>
									)}

									{hasCover && (
										<div class="package-price-card__cover relative h-36 w-full overflow-hidden rounded-t-[23px]">
											<img src={pkg.cover_url} alt={pkg.name} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
										</div>
									)}

									<div class="flex flex-1 flex-col p-5 sm:p-6">
										<div class="package-price-card__intro">
											<div class="flex items-start justify-between gap-3">
												<h3 class="font-display text-2xl font-semibold leading-tight text-sage-900">{pkg.name}</h3>
												{addons.length > 0 && (
													<span class="shrink-0 rounded-full bg-sand-100 px-2.5 py-1 text-[10px] font-semibold text-sand-800">
														+{addons.length} {txt("tambahan", "add-ons")}
													</span>
												)}
											</div>
											{pkg.description && (
												<p class="mt-2 text-[13px] leading-relaxed text-stone-500">{pkg.description}</p>
											)}
										</div>

										{(pkg.guest_capacity || pkg.event_duration_hours || pkg.venue_note) && (
											<div class="mt-4 flex flex-wrap gap-2">
												{pkg.guest_capacity && (
													<span class="inline-flex items-center gap-1.5 rounded-full bg-sage-50 px-2.5 py-1.5 text-[11px] font-medium text-sage-700">
														<Icon name="spark" size="h-3.5 w-3.5" />
														{pkg.guest_capacity} {txt("tamu", "guests")}
													</span>
												)}
												{pkg.event_duration_hours && (
													<span class="inline-flex items-center gap-1.5 rounded-full bg-sage-50 px-2.5 py-1.5 text-[11px] font-medium text-sage-700">
														<Icon name="clock" size="h-3.5 w-3.5" />
														{pkg.event_duration_hours} {txt("jam", "hours")}
													</span>
												)}
												{pkg.venue_note && (
													<span class="inline-flex items-center gap-1.5 rounded-full bg-sand-100 px-2.5 py-1.5 text-[11px] font-medium text-sand-800">
														{pkg.venue_note}
													</span>
												)}
											</div>
										)}

										<div class="package-price-card__price mt-6">
											{startingOption ? (
												<>
													<p class="text-[11px] font-medium text-stone-500">{txt("Mulai dari", "Starting at")}</p>
													<div class="mt-1 flex flex-wrap items-center gap-2">
														{startingOption.normalPriceValue > startingOption.finalPriceValue && (
															<>
																<span class="text-xs text-stone-400 line-through">
																	Rp {money(startingOption.normalPriceValue)}
																</span>
																<span class="package-price-card__saving rounded-full px-2.5 py-1 text-[10px] font-bold">
																	{txt("Hemat", "Save")} {discountPercent}%
																</span>
															</>
														)}
													</div>
													<p class="font-display text-[2rem] font-semibold leading-tight tracking-tight text-sage-950">
														Rp {money(startingOption.finalPriceValue)}
													</p>
													<p class="mt-1 text-xs text-stone-500">{startingOption.name}</p>
												</>
											) : (
												<>
													<p class="text-[11px] font-medium text-stone-500">{txt("Harga", "Price")}</p>
													<p class="mt-1 font-display text-2xl font-semibold text-sage-900">
														{txt("Konsultasi dulu", "Let’s talk")}
													</p>
													<p class="mt-1 text-xs text-stone-500">
														{txt("Harga mengikuti kebutuhan acaramu.", "Pricing follows your event needs.")}
													</p>
												</>
											)}
										</div>

										{pricedOptions.length > 1 && (
											<div class="mt-4 space-y-2 border-t border-stone-100 pt-4">
												{pricedOptions.map((option: any) => (
													<div class="flex items-center justify-between gap-3 text-xs">
														<div class="min-w-0">
															<p class="truncate font-medium text-stone-700">{option.name}</p>
															{(option.duration || option.quota) && (
																<p class="mt-0.5 truncate text-[11px] text-stone-400">
																	{option.duration || ""} {option.duration_unit || ""}
																	{option.quota && <> &middot; {option.quota} {txt("kuota", "quota")}</>}
																</p>
															)}
														</div>
														<p class="shrink-0 font-semibold text-sage-800">Rp {money(option.finalPriceValue)}</p>
													</div>
												))}
											</div>
										)}

										{features.length > 0 && (
											<div class="mt-5 border-t border-stone-100 pt-4">
												<p class="mb-3 text-[11px] font-semibold text-stone-700">
													{txt("Semua yang termasuk:", "Everything included:")}
												</p>
												<ul class="space-y-2.5">
													{visibleFeatures.map((feature: unknown) => (
														<li class="flex items-start gap-2 text-[13px] leading-snug text-stone-600">
															<span class="package-price-card__check mt-0.5">
																<Icon name="check" size="h-4 w-4" />
															</span>
															<span>{featureLabel(feature)}</span>
														</li>
													))}
												</ul>
												{extraFeatures.length > 0 && (
													<details class="group mt-3">
														<summary class="package-price-card__more flex cursor-pointer list-none items-center gap-1.5 text-xs font-semibold transition">
															{txt("Lihat semua", "See all")} {features.length} {txt("fitur", "features")}
															<svg class="h-3.5 w-3.5 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="none" aria-hidden="true">
																<path d="m5 7.5 5 5 5-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
															</svg>
														</summary>
														<ul class="mt-3 space-y-2.5">
															{extraFeatures.map((feature: unknown) => (
																<li class="flex items-start gap-2 text-[13px] leading-snug text-stone-600">
																	<span class="package-price-card__check mt-0.5">
																		<Icon name="check" size="h-4 w-4" />
																	</span>
																	<span>{featureLabel(feature)}</span>
																</li>
															))}
														</ul>
													</details>
												)}
											</div>
										)}

										<div class="package-price-card__actions mt-auto pt-6">
											<a
												href={`/packages/${pkg.slug}`}
												class="package-price-card__button flex w-full items-center justify-center gap-2 rounded-full px-5 py-3 text-sm font-semibold transition"
											>
												{txt("Lihat Paket", "View Package")}
												<Icon name="arrow" size="h-4 w-4" />
											</a>
											<a href="/formulir-konsultasi" class="package-price-card__consult mt-3 flex items-center justify-center gap-2 text-xs font-semibold transition">
												{txt("Konsultasi paket", "Ask about this package")}
											</a>
										</div>
									</div>
								</article>
							);
						})}
					</div>
				) : (
					<div class="rounded-3xl border border-stone-200 bg-white px-6 py-20 text-center">
						<span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-sage-100 text-sage-700">
							<Icon name="search" size="h-6 w-6" />
						</span>
						<h3 class="mt-5 text-lg font-bold text-sage-900">
							{txt("Belum ada paket tersedia", "No packages available")}
						</h3>
						<p class="mt-2 text-sm text-stone-500">
							{txt("Coba ubah pencarian atau filter Anda.", "Try changing your search or filter.")}
						</p>
					</div>
				)
			}

			<div class="package-catalog-note mt-8 flex flex-col gap-3 border-t border-stone-200 pt-5 sm:flex-row sm:items-center sm:justify-between">
				<p class="max-w-2xl text-xs leading-relaxed text-stone-500">
					{txt(
						"Harga paket menyesuaikan pilihan layanan, jumlah tamu, dan lokasi acara. Konsultasi awal gratis.",
						"Final pricing depends on services, guest count, and event location. The initial consultation is free.",
					)}
				</p>
				<a href="/formulir-konsultasi" class="inline-flex shrink-0 items-center gap-2 text-sm font-semibold text-terracotta-600 transition hover:text-terracotta-500">
					{txt("Konsultasikan kebutuhanmu", "Discuss your needs")}
					<Icon name="arrow" size="h-4 w-4" />
				</a>
			</div>

			{
				totalPages > 1 && (
					<nav aria-label={t.pagination} class="mt-10 flex flex-wrap items-center justify-center gap-1.5">
						{currentPage > 1 && (
							<a href={pkgHref(currentPage - 1)} rel="prev" class="rounded-full border border-sage-200 px-4 py-2 text-sm font-medium text-sage-700 transition-colors hover:bg-sage-50">
								{t.prevPage}
							</a>
						)}
						{Array.from({ length: totalPages }, (_, i) => i + 1).map((i) =>
							i === currentPage ? (
								<span aria-current="page" class="rounded-full bg-sage-700 px-4 py-2 text-sm font-semibold text-white">
									{i}
								</span>
							) : (
								<a href={pkgHref(i)} class="rounded-full border border-sage-200 px-4 py-2 text-sm font-medium text-sage-700 transition-colors hover:bg-sage-50">
									{i}
								</a>
							),
						)}
						{currentPage < totalPages && (
							<a href={pkgHref(currentPage + 1)} rel="next" class="rounded-full border border-sage-200 px-4 py-2 text-sm font-medium text-sage-700 transition-colors hover:bg-sage-50">
								{t.nextPage}
							</a>
						)}
					</nav>
				)
			}
			</div>
		</section>

		<section class="package-steps-section site-section">
			<div class="site-container">
				<div class="package-steps-heading">
					<p class="package-steps-eyebrow inline-flex rounded-full px-3.5 py-2 text-[10px] font-bold uppercase tracking-[0.16em]">
						{txt("ALUR PERENCANAAN", "THE PLANNING JOURNEY")}
					</p>
					<h2 class="mt-4 font-display text-3xl leading-tight text-sage-900 sm:text-4xl lg:text-5xl">
						{txt("Empat langkah menuju", "Four steps to")}
						{" "}
						<span class="italic text-terracotta-600">{txt("hari istimewa", "your big day")}</span>
					</h2>
					<p class="mt-4 max-w-2xl text-sm leading-relaxed text-stone-500 sm:text-base">
						{txt(
							"Dari rencana awal hingga hari pernikahan, tim kami mendampingi setiap tahap agar persiapan terasa lebih mudah.",
							"From the first plan to the wedding day, our team guides every step so the preparations feel easier.",
						)}
					</p>
				</div>

				<div class="package-steps-grid mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4">
					{steps.map((step, index) => (
						<article
							class:list={[
								"package-step-card relative flex min-w-0 flex-col rounded-[24px] p-5 sm:p-6",
								index === 0 ? "package-step-card--featured" : "",
							]}
						>
							<p class="package-step-card__label text-[10px] font-bold uppercase tracking-[0.15em]">
								{stepLabels[index]}
							</p>
							<span class="package-step-card__icon mt-3 grid h-10 w-10 place-items-center rounded-xl">
								<Icon name={stepIcons[index]} size="h-5 w-5" />
							</span>
							<h3 class="mt-3 font-display text-xl leading-snug text-sage-900">{step[1]}</h3>
							<p class="mt-2 text-sm leading-relaxed text-stone-500">{step[2]}</p>
							<span
								class="package-step-card__number pointer-events-none absolute right-5 top-5 font-display text-3xl"
								aria-hidden="true"
							>
								{step[0]}
							</span>
							{index < steps.length - 1 && (
								<span
									class="package-step-card__connector absolute -right-5 top-1/2 z-10 hidden h-10 w-10 -translate-y-1/2 place-items-center rounded-full xl:grid"
									aria-hidden="true"
								>
									<Icon name="arrow" size="h-4 w-4" />
								</span>
							)}
						</article>
					))}
				</div>
			</div>
		</section>

		{
			packageFaqGroups.length > 0 && (
				<HomeFaqSection
					sectionId="package-faq"
					groups={packageFaqGroups}
					eyebrow={t.homeFaqEyebrow}
					expandAll={t.homeFaqExpandAll}
					collapseAll={t.homeFaqCollapseAll}
					stillTitle={t.homeFaqStillTitle}
					stillDesc={t.homeFaqStillDesc}
					stillButton={t.homeFaqStillBtn}
					viewAll={t.homeFaqViewAll}
					whatsappHref={contactLinks.whatsappShortLink}
				/>
			)
		}

		<section class="package-guidance-section site-section" aria-labelledby="package-guidance-title">
			<div class="site-container">
				<div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
					<div>
						<p class="package-guidance-eyebrow">{txt("KETENTUAN", "GOOD TO KNOW")}</p>
						<h2
							id="package-guidance-title"
							class="package-guidance-title mt-4 max-w-sm font-display text-sage-950"
						>
							<span class="block">{txt("Yang perlu", "Good to")}</span>
							<span class="italic text-terracotta-600">{txt("kamu tahu", "know")}</span>
						</h2>
						<p class="package-guidance-description mt-5 max-w-sm">
							{txt(
								"Ada pertanyaan soal paket, jadwal, atau acara di luar kota? Tim kami siap membantu lewat WhatsApp.",
								"Questions about packages, timing, or an out-of-town event? Our team is happy to help via WhatsApp.",
							)}
						</p>
						<a
							href={contactLinks.whatsappShortLink}
							target="_blank"
							rel="noopener noreferrer"
							class="package-guidance-link mt-5 inline-flex items-center gap-2 font-semibold"
						>
							{txt("Tanya tim kami", "Ask our team")}
							<Icon name="arrow" size="h-4 w-4" />
						</a>
					</div>

					<div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-2">
						{
							packageGuidanceItems.map((item) => (
								<article class="package-guidance-item border-t pt-4">
									<div class="flex items-center gap-3">
										<span class="package-guidance-icon grid h-8 w-8 place-items-center rounded-lg">
											<Icon name={item.icon} size="h-4 w-4" />
										</span>
										<h3 class="package-guidance-item-title font-bold text-sage-900">{item.title}</h3>
									</div>
									<p class="package-guidance-item-description mt-2">
										{item.description}
									</p>
								</article>
							))
						}
					</div>
				</div>
			</div>
		</section>

		<section class="package-contact-section site-section">
			<div class="site-container">
				<div class="package-contact-card mx-auto grid overflow-hidden rounded-[28px] lg:grid-cols-[1.05fr_0.95fr]">
					<div class="package-contact-copy flex flex-col justify-center p-7 sm:p-10 lg:p-16">
						<img
							class="package-contact-decoration"
							src="/img/mawar-kiri.webp"
							alt=""
							aria-hidden="true"
							loading="lazy"
							decoding="async"
						/>
						<h2 class="package-contact-title font-display text-3xl leading-[1.12] text-sage-950 sm:text-4xl lg:text-5xl">
							{txt("Belum yakin paket mana yang", "Not sure which package")}
							{" "}
							<span class="italic text-terracotta-600">{txt("pas", "fits you")}</span>?
						</h2>
						<p class="mt-5 max-w-lg text-sm leading-relaxed text-stone-600 sm:text-base">
							{txt(
								"Kirim tanggal acara dan perkiraan jumlah tamu, tim kami bantu memilihkan paket yang paling cocok.",
								"Share your wedding date and guest estimate. Our team will help you find the package that fits.",
							)}
						</p>
						<div class="mt-6 flex flex-wrap items-center gap-3">
							<a
								href={waLink}
								target="_blank"
								rel="noopener noreferrer"
								class="package-contact-whatsapp inline-flex min-h-12 items-center gap-3 rounded-full py-1.5 pl-5 pr-1.5 text-sm font-semibold text-white transition"
							>
								{txt("Tanya via WhatsApp", "Ask via WhatsApp")}
								<span class="grid h-9 w-9 place-items-center rounded-full bg-white text-terracotta-600">
									<Icon name="whatsapp" size="h-4 w-4" />
								</span>
							</a>
							<a
								href="/gallery"
								class="package-contact-gallery inline-flex min-h-12 items-center justify-center rounded-full border px-5 py-3 text-sm font-semibold transition"
							>
								{txt("Lihat desain undangan", "View wedding inspiration")}
							</a>
						</div>
					</div>
					<div class="package-contact-image">
						<img
							src="/img/bg-kontak.jpg"
							alt={txt("Pasangan pengantin di hari pernikahan", "A couple celebrating their wedding day")}
							loading="lazy"
							decoding="async"
						/>
					</div>
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	import "../lib/browser/lib/home-faq";
</script>
