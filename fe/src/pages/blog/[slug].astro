---
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { ArticleView, VenueLink } from "../../lib/pageData.js";
import {
	firstString,
	normalizeBlogPost,
	normalizeBlogPosts,
	normalizeVenueLinks,
} from "../../lib/pageData.js";
import { getPageBatch } from "../../lib/services/batchService.js";
import { toApiError } from "../../lib/utils/errors.js";
import { sanitizeRichHtml } from "../../lib/utils/sanitize.js";
import { cleanSlug } from "../../lib/utils/validate.js";

const { lang, t, currentUrl } = Astro.locals;
const isID = lang === "id";
const locale = isID ? "id-ID" : "en-US";

let post: ArticleView | null = null;
let related: ArticleView[] = [];
let popularPosts: ArticleView[] = [];
let sidebarVenues: VenueLink[] = [];
let notFound = false;

try {
	const slug = cleanSlug(Astro.params.slug, "article");
	const data = await getPageBatch("blog-detail", { slug });
	const rawPost = normalizeBlogPost(data?.post, locale);
	if (!rawPost) {
		notFound = true;
	} else {
		post = { ...rawPost, content: sanitizeRichHtml(rawPost.content) };
		related = normalizeBlogPosts(data?.related, locale).slice(0, 3);
		popularPosts = normalizeBlogPosts(data?.popular, locale).slice(0, 3);
		sidebarVenues = normalizeVenueLinks(data?.venues).slice(0, 3);
	}
} catch (e) {
	const err = toApiError(e);
	if (err.status !== 404 && err.status !== 400) throw err;
	notFound = true;
}

const isNotFound = notFound || !post;
if (isNotFound) Astro.response.status = 404;

const excerptText = post
	? post.excerpt
			.replace(/<[^>]*>/g, " ")
			.replace(/\s+/g, " ")
			.trim()
	: "";
const descriptionText = post
	? excerptText.length >= 40
		? excerptText
		: isID
			? `Baca ${post.title} — panduan dan inspirasi pernikahan dari Sagita Wedding Planner.`
			: `Read ${post.title} — wedding planning guidance and inspiration from Sagita Wedding Planner.`
	: "";
const title = post ? `${post.title} | Sagita Wedding` : "Article Not Found";
const articleImage = post?.image || undefined;
const publishedAt = post?.publishedAt || undefined;
const author = post ? firstString(post.author) : "";
---

<BaseLayout
	title={title}
	metaDescription={descriptionText}
	robots={isNotFound ? "noindex, nofollow" : undefined}
	heroNav={isNotFound || undefined}
	ogType={post ? "article" : undefined}
	ogImage={articleImage}
	breadcrumbs={post
		? [
				{ name: t.nav?.home || "Home", url: "/" },
				{ name: t.nav?.articles || "Blog", url: "/blog" },
				{ name: post.title },
			]
		: undefined}
	articleMeta={post
		? {
				headline: post.title,
				description: descriptionText,
				image: articleImage,
				section: firstString(post.category) || undefined,
				datePublished: publishedAt,
				dateModified: post.modifiedAt || publishedAt || undefined,
			}
		: undefined}
>
	{post ? (
		<main class="blog-detail-page">
			<div class="site-container blog-detail-shell">
				<nav aria-label="Breadcrumb" class="blog-breadcrumb">
					<ol>
						<li>
							<a href="/">{t.nav?.home || "Home"}</a>
						</li>
						<li aria-hidden="true">/</li>
						<li>
							<a href="/blog">Blog</a>
						</li>
						<li aria-hidden="true">/</li>
						<li aria-current="page">{post.title}</li>
					</ol>
				</nav>

				<article class="blog-detail-article">
					<div class="blog-detail-layout">
						<div class="blog-detail-main">
							<header class="blog-detail-header">
								<div class="blog-detail-meta">
									{post.category && (
										<span class="blog-detail-category">{post.category}</span>
									)}
									{post.date && (
										<span class="blog-detail-date">{post.date}</span>
									)}
									{post.read && (
										<>
											<span class="blog-detail-dot" aria-hidden="true">•</span>
											<span class="blog-detail-read">{post.read}</span>
										</>
									)}
									{author && (
										<>
											<span class="blog-detail-dot" aria-hidden="true">•</span>
											<span class="blog-detail-author">{author}</span>
										</>
									)}
								</div>

								<h1 class="blog-detail-title">{post.title}</h1>

								{post.excerpt && (
									<p class="blog-detail-excerpt">{post.excerpt}</p>
								)}

								{post.image && (
									<figure class="blog-detail-figure">
										<img
											src={post.image}
											alt={post.title}
											loading="eager"
											decoding="async"
											data-img-error="closest-figure"
											class="blog-detail-image"
										/>
									</figure>
								)}
							</header>

							<div class="blog-detail-content article-content" set:html={post.content}></div>

							<footer class="blog-detail-footer">
								<a href="/blog" class="blog-back-link">
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"></path><path d="m12 19-7-7 7-7"></path></svg>
									{t.blogBack}
								</a>
							</footer>
						</div>

						<aside class="blog-detail-aside">
							<div class="blog-share-card">
								<p class="blog-share-title">{t.shareArticle}</p>
								<button
									id="nativeShareBtn"
									type="button"
									class="blog-share-native"
									hidden
									data-title={post.title}
									data-url={currentUrl}
								>
									<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"></path><path d="M16 6l-4-4-4 4"></path><path d="M12 2v13"></path></svg>
									<span>{t.blogShareNative}</span>
								</button>
								<div class="blog-share-actions">
									<a
										href={`https://wa.me/?text=${encodeURIComponent(`${post.title} ${currentUrl}`)}`}
										target="_blank"
										rel="noopener noreferrer"
										aria-label="Share on WhatsApp"
										class="blog-share-button blog-share-button--icon"
									>
										<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.91 9.91 0 0 0-8.5 15.03L2 22l5.06-1.5A9.9 9.9 0 1 0 12.04 2Zm5.8 14.06c-.24.68-1.4 1.3-1.94 1.35-.52.05-1.17.24-3.9-.81-3.28-1.31-5.34-4.72-5.5-4.94-.16-.22-1.32-1.75-1.32-3.34s.84-2.37 1.13-2.7c.3-.32.64-.4.86-.4h.62c.2 0 .46-.07.72.55.27.64.92 2.23.99 2.39.08.16.13.35.02.57-.1.22-.16.35-.31.54-.15.19-.32.43-.46.57-.15.16-.31.33-.13.64.18.31.8 1.32 1.72 2.14 1.18 1.05 2.18 1.38 2.49 1.53.31.16.49.13.67-.08.18-.2.77-.9.98-1.2.2-.31.4-.26.68-.16.28.11 1.76.83 2.06.98.3.15.5.23.57.35.08.13.08.72-.16 1.42Z"/></svg>
									</a>
									<a
										href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`}
										target="_blank"
										rel="noopener noreferrer"
										aria-label="Share on Facebook"
										class="blog-share-button blog-share-button--icon"
									>
										<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2-.1-2 0-3.4 1.2-3.4 3.5V11H8.5v3H11v7h2.5Z"/></svg>
									</a>
									<a
										href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(currentUrl)}`}
										target="_blank"
										rel="noopener noreferrer"
										aria-label="Share on X"
										class="blog-share-button blog-share-button--icon"
									>
										<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.8 3h3l-6.6 7.6L22 21h-6.1l-4.8-6.3L5.6 21h-3l7.1-8.1L2 3h6.3l4.3 5.7L17.8 3Zm-1.1 16.1h1.7L7.4 4.8H5.6l11.1 14.3Z"/></svg>
									</a>
									<button
										type="button"
										id="copyLinkBtn"
										class="blog-share-button blog-share-copy"
										data-url={currentUrl}
										data-copied={t.copiedLink}
										data-label={t.blogCopyLink}
									>
										<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
										<span data-copy-label>{t.blogCopyLink}</span>
									</button>
								</div>
							</div>

							{popularPosts.length > 0 && (
								<section class="blog-sidebar-card">
									<h2 class="blog-sidebar-title">{t.blogPopularPosts}</h2>
									<ol class="blog-popular-list">
										{popularPosts.map((item, index) => (
											<li>
												<a href={`/blog/${item.slug}`} class="blog-popular-item">
													<span class="blog-popular-index">{String(index + 1).padStart(2, "0")}</span>
													<span class="blog-popular-copy">
														{item.category && (
															<span class="blog-popular-category">{item.category}</span>
														)}
														<span class="blog-popular-title">{item.title}</span>
														{item.date && (
															<span class="blog-popular-date">{item.date} <span class="blog-meta-dot">•</span> {item.read}</span>
														)}
													</span>
												</a>
											</li>
										))}
									</ol>
								</section>
							)}

							{sidebarVenues.length > 0 && (
								<section class="blog-sidebar-card">
									<h2 class="blog-sidebar-title">{t.blogVenueList}</h2>
									<ul class="blog-venue-list">
										{sidebarVenues.map((venue) => (
											<li>
												<a href={`/venues#venue-${venue.slug}`} class="blog-venue-item">
													<span class="blog-venue-thumb">
														{venue.image ? (
															<img src={venue.image} alt={venue.name} loading="lazy" decoding="async" data-img-error="remove" />
														) : (
															<span aria-hidden="true">SW</span>
														)}
													</span>
													<span class="blog-venue-copy">
														<span class="blog-venue-name">{venue.name}</span>
														{venue.address && (
															<span class="blog-venue-address">{venue.address}</span>
														)}
													</span>
													<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
												</a>
											</li>
										))}
									</ul>
									<a href="/venues" class="blog-sidebar-all">
										{t.viewAllVenues}
										<svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
									</a>
								</section>
							)}
						</aside>
					</div>
				</article>

				{related.length > 0 && (
					<section class="blog-related">
						<div class="blog-related-heading">
							<div>
								<p class="blog-eyebrow">
									<span class="blog-eyebrow-line" aria-hidden="true"></span>
									{t.homeArticlesEyebrow}
								</p>
								<h2>{t.relatedArticles}</h2>
							</div>
							<a href="/blog" class="blog-related-all">
								{t.viewAllArticles}
								<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
							</a>
						</div>
						<div class="blog-grid">
							{related.map((item) => (
								<a href={`/blog/${item.slug}`} class="article-card blog-card">
									<div class="blog-card-media">
										{item.image ? (
											<img src={item.image} alt={item.title} loading="lazy" decoding="async" data-img-error="remove" class="blog-card-image" />
										) : (
											<div class="blog-card-placeholder" aria-hidden="true"><span>SW</span></div>
										)}
									</div>
									<div class="blog-card-body">
										<div class="blog-card-meta">
											{item.category && (
												<span class="blog-card-category">{item.category}</span>
											)}
											<span class="blog-card-date">{item.date} <span class="blog-meta-dot">•</span> {item.read}</span>
										</div>
										<h3 class="blog-card-title">{item.title}</h3>
										{item.excerpt && (
											<p class="blog-card-excerpt">{item.excerpt}</p>
										)}
										<span class="blog-card-link">
											{t.homeArticleReadMore}
											<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
										</span>
									</div>
								</a>
							))}
						</div>
					</section>
				)}
			</div>
		</main>
	) : (
		<main class="site-container site-page-content py-20 text-center">
			<p class="font-display text-6xl text-sage-900">404</p>
			<h1 class="mt-4 font-display text-3xl text-sage-900">{t.notFoundTitle}</h1>
			<p class="mt-3 text-stone-warm">{t.notFoundDesc}</p>
			<a href="/" class="btn-primary mt-8 inline-flex text-sm px-6 py-3">{t.notFoundBack}</a>
		</main>
	)}
	<script>import "../../lib/browser/pages/blog-detail";</script>
</BaseLayout>
