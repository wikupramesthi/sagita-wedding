---
import ExploreLinks from "../../components/ExploreLinks.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageBatch } from "../../lib/services/batchService.js";
import { cleanSlug } from "../../lib/utils/validate.js";

const { lang, dateLocale, t } = Astro.locals;

let packageDetail: any = null;
try {
	const slug = cleanSlug(Astro.params.slug, "package");
	const data = await getPageBatch("package-detail", { slug });
	packageDetail = data?.package ?? null;
} catch {
	packageDetail = null;
}

const notFound = !packageDetail || typeof packageDetail !== "object";
if (notFound) Astro.response.status = 404;

const pkg: any = packageDetail || {};
const options = Array.isArray(pkg.options) ? pkg.options : [];
const features = Array.isArray(pkg.features) ? pkg.features : [];
const featureGroups: { category: string; items: string[] }[] = [];
const featureGroupMap = new Map<
	string,
	{ category: string; items: string[] }
>();
features.forEach((feature: any) => {
	const text =
		feature && typeof (feature.feature || feature.name) === "string"
			? String(feature.feature || feature.name).trim()
			: "";
	if (!text) return;

	const category =
		typeof feature.category === "string" ? feature.category.trim() : "";
	let group = featureGroupMap.get(category);
	if (!group) {
		group = { category, items: [] };
		featureGroupMap.set(category, group);
		featureGroups.push(group);
	}
	group.items.push(
		...text
			.split(",")
			.map((item: string) => item.trim())
			.filter(Boolean),
	);
});

const addons = Array.isArray(pkg.addons) ? pkg.addons : [];
const promos = Array.isArray(pkg.promos) ? pkg.promos : [];
const blackoutDates = Array.isArray(pkg.blackout_dates)
	? pkg.blackout_dates
	: [];
const addonNames = new Map<string, string>(
	addons
		.filter((addon: any) => addon?.uuid && addon.name)
		.map((addon: any) => [addon.uuid, addon.name] as [string, string]),
);
const isPopular = pkg.is_popular;
const numberLocale = lang === "id" ? "id-ID" : "en-US";

function formatDate(value: unknown): string {
	if (!value) return "";
	const date = new Date(String(value));
	if (Number.isNaN(date.getTime())) return String(value);
	return new Intl.DateTimeFormat(dateLocale || numberLocale, {
		day: "numeric",
		month: "short",
		year: "numeric",
	}).format(date);
}

function promoLabel(promo: any): string {
	const value = new Intl.NumberFormat(numberLocale).format(
		Number(promo?.value ? promo.value : 0),
	);
	return promo && promo.type === "percent" ? `${value}%` : `Rp ${value}`;
}

function formatPrice(price: unknown): string {
	return new Intl.NumberFormat(numberLocale).format(Number(price || 0));
}

const description =
	typeof pkg.description === "string"
		? pkg.description
				.replace(/<[^>]*>/g, " ")
				.replace(/\s+/g, " ")
				.trim()
		: "";
const error = notFound ? "Package not found." : null;
---

<BaseLayout
	title={notFound ? "Package Not Found" : `${pkg.name} | Wedding Package | Sagita Wedding`}
	metaDescription={notFound || !description ? undefined : description}
	robots={notFound ? "noindex, nofollow" : undefined}
	breadcrumbs={notFound
		? undefined
		: [
				{ name: t.nav?.home || "Home", url: "/" },
				{ name: t.nav?.packages || "Wedding Packages", url: "/packages" },
				{ name: String(pkg.name || "") },
			]}
>
	<main class="bg-cream min-h-screen">
		{
			!notFound ? (
				<>
					<section class="site-section--compact max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-8">
						<div class="max-w-6xl mx-auto px-6">
							<nav aria-label="Breadcrumb" class="mb-8 text-xs sm:text-sm text-stone-warm">
								<ol class="flex flex-wrap items-center gap-2">
									<li>
										<a href="/" class="hover:text-sage-700 transition-colors">{t.nav?.home || "Home"}</a>
									</li>
									<li aria-hidden="true" class="opacity-60">/</li>
									<li>
										<a href="/packages" class="hover:text-sage-700 transition-colors">{t.nav?.packages || "Wedding Packages"}</a>
									</li>
									<li aria-hidden="true" class="opacity-60">/</li>
									<li aria-current="page" class="text-sage-900 font-medium truncate max-w-[60vw]">{pkg.name}</li>
								</ol>
							</nav>

							<div class="max-w-3xl">
								{isPopular && (
									<span
										class="inline-flex items-center gap-1.5
										       bg-terracotta-500
										       text-white
										       text-[10px]
										       font-bold
										       tracking-widest
										       px-3 py-1.5
										       rounded-full
										       mb-5"
									>
										<i class="bi bi-star-fill"></i>
										{t.mostPopular}
									</span>
								)}

								<h1
									class="font-display
									       text-4xl md:text-5xl
									       font-bold
									       text-sage-900
									       leading-tight"
								>
									{pkg.name}
								</h1>

								{pkg.description && (
									<p
										class="mt-4
										       text-base md:text-lg
										       leading-relaxed
										       text-stone-warm
										       max-w-2xl"
									>
										{pkg.description}
									</p>
								)}
							</div>
						</div>
					</section>

					<section class="pb-20">
						<div
							class="max-w-6xl
							       mx-auto
							       px-6
							       grid
							       grid-cols-1
							       lg:grid-cols-3
							       gap-8"
						>
							<div class="lg:col-span-2 space-y-6">
								<div
									class="bg-white
									       border border-stone-200
									       rounded-[24px]
									       p-6 md:p-8"
								>
									<div class="mb-6">
										<h2
											class="font-display
											       text-2xl
											       font-bold
											       text-sage-900"
										>
											{t.chooseYourOption}
										</h2>
										<p class="text-sm text-stone-400 mt-1">{t.chooseYourOptionDesc}</p>
									</div>

									<div class="space-y-3">
										{options.map((option: any) => (
											<div
												class="relative
												       rounded-2xl
												       border border-stone-200
												       bg-stone-50
												       p-5
												       transition
												       hover:border-sage-300
												       hover:bg-white"
											>
												<div
													class="flex
													       flex-col
													       sm:flex-row
													       sm:items-center
													       sm:justify-between
													       gap-4"
												>
													<div>
														<h3 class="font-semibold text-sage-900">{option.name}</h3>
													</div>

													<div class="sm:text-right shrink-0">
														{option.discount_price &&
															Number(option.discount_price) < Number(option.price) && (
																<p class="text-xs text-stone-400 line-through">
																	Rp {formatPrice(option.price)}
																</p>
															)}
														<p class="text-lg font-bold text-sage-700">
															Rp {formatPrice(option.final_price ?? option.price)}
														</p>
													</div>
												</div>
											</div>
										))}
									</div>
								</div>

								{features.length > 0 && (
									<div
										class="bg-white
										       border border-stone-200
										       rounded-[24px]
										       p-6 md:p-8"
									>
										<h2
											class="font-display
											       text-2xl
											       font-bold
											       text-sage-900"
										>
											{t.whatsIncluded}
										</h2>

										<div class="mt-6 space-y-6">
											{featureGroups.map((group) => (
												<section>
													{group.category && (
														<h3 class="mb-3 text-sm font-bold uppercase tracking-wide text-sage-800">
															{group.category}
														</h3>
													)}
													<ul class="grid list-none grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
														{group.items.map((feature) => (
															<li class="flex items-start gap-3 text-sm text-stone-warm">
																<span aria-hidden="true" class="mt-0.5 shrink-0 text-sage-700">
																	<svg
																		xmlns="http://www.w3.org/2000/svg"
																		width="18"
																		height="18"
																		viewBox="0 0 24 24"
																		fill="none"
																		stroke="currentColor"
																		stroke-width="2.5"
																		stroke-linecap="round"
																		stroke-linejoin="round"
																	>
																		<polyline points="20 6 9 17 4 12"></polyline>
																	</svg>
																</span>
																<span>{feature}</span>
															</li>
														))}
													</ul>
												</section>
											))}
										</div>
									</div>
								)}

								{(Number(pkg.lead_time_days) > 0 || blackoutDates.length > 0) && (
									<div
										class="bg-white
										       border border-stone-200
										       rounded-[24px]
										       p-6 md:p-8"
									>
										<h2 class="font-display text-xl font-bold text-sage-900">
											{t.leadTime}
										</h2>

										{Number(pkg.lead_time_days) > 0 && (
											<p class="mt-3 text-sm text-stone-warm">
												<i class="bi bi-clock-history me-2 text-sage-700"></i>
												{pkg.lead_time_days} {t.leadTimeDays}
											</p>
										)}

										{blackoutDates.length > 0 && (
											<>
												<h3 class="mt-5 text-xs font-bold uppercase tracking-wide text-stone-400">
													{t.blackoutDates}
												</h3>
												<div class="mt-2 flex flex-wrap gap-2">
													{blackoutDates.map((item: any) => (
														<span class="rounded-full bg-terracotta-50 px-3 py-1 text-xs text-terracotta-700">
															{formatDate(item && item.date)}
															{item && item.reason && <> — {item.reason}</>}
														</span>
													))}
												</div>
											</>
										)}
									</div>
								)}

								{addons.length > 0 && (
									<div
										class="bg-white
										       border border-stone-200
										       rounded-[24px]
										       p-6 md:p-8"
									>
										<h2 class="font-display text-xl font-bold text-sage-900">
											{t.addonsTitle}
										</h2>

										<div class="mt-5 space-y-4">
											{addons.map((addon: any) => (
												<div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
													<div class="flex flex-wrap items-start justify-between gap-3">
														<div>
															<h3 class="font-semibold text-sage-900">{addon.name}</h3>
															{addon.description && (
																<p class="mt-1 text-xs text-stone-500">{addon.description}</p>
															)}
															{addon.requires_addon_uuid && addonNames.get(addon.requires_addon_uuid) && (
																<p class="mt-1 text-xs text-terracotta-700">
																	<i class="bi bi-link-45deg me-1"></i>
																	{addonNames.get(addon.requires_addon_uuid)}
																</p>
															)}
														</div>
														<p class="font-bold text-sage-700">
															Rp {formatPrice(addon.final_price ?? addon.price)}
														</p>
													</div>
													<p class="mt-2 text-[11px] uppercase tracking-wide text-stone-400">
														{t.minQuantity} {addon.min_quantity ?? 1} · {t.maxQuantity}{" "}
														{addon.max_quantity ?? 99}
													</p>
												</div>
											))}
										</div>
									</div>
								)}

								{promos.length > 0 && (
									<div
										class="bg-white
										       border border-stone-200
										       rounded-[24px]
										       p-6 md:p-8"
									>
										<h2 class="font-display text-xl font-bold text-sage-900">
											{t.activePromos}
										</h2>

										<div class="mt-4 flex flex-wrap gap-2">
											{promos.map((promo: any) => (
												<span class="rounded-full bg-sage-50 px-3 py-1 text-xs font-semibold text-sage-800">
													{promo.code} · {promoLabel(promo)}
												</span>
											))}
										</div>
									</div>
								)}
							</div>

							<aside>
								<div
									class="bg-sage-700
									       text-white
									       rounded-[24px]
									       p-7
									       lg:sticky
									       lg:top-28"
								>
									<p
										class="text-xs
										       uppercase
										       tracking-widest
										       text-sage-200"
									>
										Sagita Wedding Organizer
									</p>

									<h2
										class="font-display
										       text-2xl
										       font-bold
										       mt-2"
									>
										{pkg.name}
									</h2>

									<div
										class="border-t
										       border-white/10
										       my-6"
									></div>

									<p class="text-sm text-sage-200 leading-relaxed">
										{t.chooseYourPackageDesc}
									</p>

									<button
										type="button"
										data-action="open-booking"
										data-package-uuid={pkg.uuid}
										data-package-slug={pkg.slug}
										class="w-full
										       mt-7
										       py-3.5
										       rounded-full
										       bg-white
										       text-sage-700
										       flex
										       items-center
										       justify-center
										       gap-2
										       font-semibold
										       text-sm
										       hover:bg-sage-50
										       transition"
									>
										{t.chooseYourPackage}

										<svg
											xmlns="http://www.w3.org/2000/svg"
											width="17"
											height="17"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<line x1="5" y1="12" x2="19" y2="12"></line>
											<polyline points="12 5 19 12 12 19"></polyline>
										</svg>
									</button>
								</div>
							</aside>
						</div>
					</section>
					<ExploreLinks heading={t.nav?.packages || "Wedding Packages"} />
				</>
			) : (
				<section class="max-w-3xl mx-auto px-4 py-20 text-center">
					<div class="text-6xl">📦</div>
					<h1 class="font-display text-3xl font-bold mt-4 text-sage-900">
						{t.packageNotFoundTitle}
					</h1>
					<p class="text-stone-warm mt-2">{error || t.packageNotFoundDesc}</p>
					<a href="/packages" class="inline-block mt-6 bg-sage-700 text-white px-7 py-3 rounded-full font-semibold">
						{t.packagesTitleA} →
					</a>
				</section>
			)
		}
	</main>
</BaseLayout>
