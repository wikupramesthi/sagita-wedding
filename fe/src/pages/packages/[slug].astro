---
import Icon from "../../components/Icon.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPageBatch } from "../../lib/services/batchService.js";
import { cleanSlug } from "../../lib/utils/validate.js";

const { lang, dateLocale, t, contactLinks } = Astro.locals;

let packageDetail: any = null;
try {
	const slug = cleanSlug(Astro.params.slug, "package");
	const data = await getPageBatch("package-detail", { slug });
	packageDetail = data?.package ?? null;
} catch {
	packageDetail = null;
}

const notFound = !packageDetail || typeof packageDetail !== "object";
if (notFound) Astro.response.status = 404;

const pkg: any = packageDetail || {};
const options = Array.isArray(pkg.options) ? pkg.options : [];
const features = Array.isArray(pkg.features) ? pkg.features : [];
const featureGroups: { category: string; items: string[] }[] = [];
const featureGroupMap = new Map<
	string,
	{ category: string; items: string[] }
>();
features.forEach((feature: any) => {
	const text =
		feature && typeof (feature.feature || feature.name) === "string"
			? String(feature.feature || feature.name).trim()
			: "";
	if (!text) return;

	const category =
		typeof feature.category === "string" ? feature.category.trim() : "";
	let group = featureGroupMap.get(category);
	if (!group) {
		group = { category, items: [] };
		featureGroupMap.set(category, group);
		featureGroups.push(group);
	}
	group.items.push(
		...text
			.split(",")
			.map((item: string) => item.trim())
			.filter(Boolean),
	);
});

const addons = Array.isArray(pkg.addons) ? pkg.addons : [];
const promos = Array.isArray(pkg.promos) ? pkg.promos : [];
const blackoutDates = Array.isArray(pkg.blackout_dates)
	? pkg.blackout_dates
	: [];
const addonNames = new Map<string, string>(
	addons
		.filter((addon: any) => addon?.uuid && addon.name)
		.map((addon: any) => [addon.uuid, addon.name] as [string, string]),
);
const isPopular =
	pkg.is_popular === true || pkg.is_popular === 1 || pkg.is_popular === "1";
const numberLocale = lang === "id" ? "id-ID" : "en-US";
const pricedOptions = options
	.map((option: any) => ({
		...option,
		finalPriceValue: Number(option.final_price ?? option.price ?? 0),
		normalPriceValue: Number(option.price ?? 0),
	}))
	.filter((option: any) => option.finalPriceValue > 0)
	.sort((a: any, b: any) => a.finalPriceValue - b.finalPriceValue);
const startingOption = pricedOptions[0] ?? null;
const coverImage =
	typeof pkg.cover_url === "string" && pkg.cover_url.trim()
		? pkg.cover_url.trim()
		: "";
const totalFeatures = featureGroups.reduce(
	(sum, group) => sum + group.items.length,
	0,
);
const copy =
	lang === "id"
		? {
				startingFrom: "Mulai dari",
				highlights: "Sorotan paket",
				guest: "tamu",
				hour: "jam",
				items: "item",
				promo: "promo",
			}
		: {
				startingFrom: "Starting from",
				highlights: "Package highlights",
				guest: "guests",
				hour: "hours",
				items: "items",
				promo: "promos",
			};

function formatDate(value: unknown): string {
	if (!value) return "";
	const date = new Date(String(value));
	if (Number.isNaN(date.getTime())) return String(value);
	return new Intl.DateTimeFormat(dateLocale || numberLocale, {
		day: "numeric",
		month: "short",
		year: "numeric",
	}).format(date);
}

function promoLabel(promo: any): string {
	const value = new Intl.NumberFormat(numberLocale).format(
		Number(promo?.value ? promo.value : 0),
	);
	return promo && promo.type === "percent" ? `${value}%` : `Rp ${value}`;
}

function formatPrice(price: unknown): string {
	return new Intl.NumberFormat(numberLocale).format(Number(price || 0));
}

const description =
	typeof pkg.description === "string"
		? pkg.description
				.replace(/<[^>]*>/g, " ")
				.replace(/\s+/g, " ")
				.trim()
		: "";
const error = notFound ? "Package not found." : null;
---

<BaseLayout
	title={notFound ? "Package Not Found" : `${pkg.name} | Wedding Package | Sagita Wedding`}
	metaDescription={notFound || !description ? undefined : description}
	robots={notFound ? "noindex, nofollow" : undefined}
	heroImage={coverImage || undefined}
	breadcrumbs={notFound
		? undefined
		: [
				{ name: t.nav?.home || "Home", url: "/" },
				{ name: t.nav?.packages || "Wedding Packages", url: "/packages" },
				{ name: String(pkg.name || "") },
			]}
>
	<main class="package-detail-page min-h-screen bg-cream">
		{
			!notFound ? (
				<>
					<section class="package-detail-hero site-section--compact">
						<div class="site-container">
						<nav aria-label="Breadcrumb" class="text-xs text-stone-warm sm:text-sm">
							<ol class="flex flex-wrap items-center gap-2">
								<li>
									<a href="/" class="transition-colors hover:text-sage-700">{t.nav?.home || "Home"}</a>
								</li>
								<li aria-hidden="true" class="opacity-60">/</li>
								<li>
									<a href="/packages" class="transition-colors hover:text-sage-700">{t.nav?.packages || "Wedding Packages"}</a>
								</li>
								<li aria-hidden="true" class="opacity-60">/</li>
								<li aria-current="page" class="max-w-[60vw] truncate font-medium text-sage-900">{pkg.name}</li>
							</ol>
						</nav>

						<div class="mt-8 grid items-center gap-8 lg:mt-10 lg:grid-cols-[minmax(0,1.08fr)_minmax(320px,0.92fr)] lg:gap-12">
							<div class="min-w-0">
								{isPopular && (
									<span
										class="mb-5 inline-flex items-center gap-1.5 rounded-full bg-terracotta-500 px-3 py-1.5 text-[10px] font-bold tracking-widest text-white"
									>
										<i class="bi bi-star-fill"></i>
										{t.mostPopular}
									</span>
								)}

								<p class="package-detail-eyebrow mb-3">
									{t.nav?.packages || "Wedding Packages"}
								</p>
								<h1
									class="font-display text-4xl font-bold leading-tight text-sage-900 md:text-5xl"
								>
									{pkg.name}
								</h1>

								{pkg.description && (
									<p class="mt-4 max-w-2xl text-base leading-relaxed text-stone-warm md:text-lg">
										{pkg.description}
									</p>
								)}

								<div class="mt-7 flex flex-wrap gap-2">
									{startingOption && (
										<span class="inline-flex items-center gap-2 rounded-full border border-sage-200 bg-white px-3.5 py-2 text-xs font-semibold text-sage-800 shadow-sm">
											<Icon name="wallet" size="h-3.5 w-3.5" />
											{copy.startingFrom} Rp {formatPrice(startingOption.finalPriceValue)}
										</span>
									)}
									{Number(pkg.guest_capacity) > 0 && (
										<span class="inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-3.5 py-2 text-xs font-medium text-stone-warm">
											{pkg.guest_capacity} {copy.guest}
										</span>
									)}
									{Number(pkg.event_duration_hours) > 0 && (
										<span class="inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-3.5 py-2 text-xs font-medium text-stone-warm">
											{pkg.event_duration_hours} {copy.hour}
										</span>
									)}
									{totalFeatures > 0 && (
										<span class="inline-flex items-center gap-2 rounded-full border border-stone-200 bg-white px-3.5 py-2 text-xs font-medium text-stone-warm">
											{totalFeatures} {copy.items}
										</span>
									)}
								</div>

								<div class="mt-8 flex flex-wrap gap-3">
									<a
										href="#package-options"
										class="inline-flex items-center gap-2 rounded-full bg-sage-700 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-sage-800"
									>
										{t.chooseYourOption}
										<Icon name="arrow" size="h-4 w-4" />
									</a>
									<a
										href={contactLinks.whatsappLink}
										target="_blank"
										rel="noopener noreferrer"
										class="inline-flex items-center gap-2 rounded-full border border-sage-300 px-6 py-3 text-sm font-semibold text-sage-800 transition hover:border-sage-700 hover:bg-sage-50"
									>
										<Icon name="whatsapp" size="h-4 w-4" />
										{t.ctaHelpBtn}
									</a>
								</div>
							</div>

							<div class="package-detail-hero-card relative isolate overflow-hidden rounded-[28px] border border-stone-200 bg-sage-800 shadow-[0_24px_70px_rgba(44,64,53,0.18)]">
								{
									coverImage ? (
										<img
											src={coverImage}
											alt={pkg.name}
											width="1200"
											height="900"
											class="absolute inset-0 h-full w-full object-cover"
										/>
									) : (
										<>
											<div class="absolute inset-0 bg-gradient-to-br from-sage-800 via-sage-700 to-terracotta-600"></div>
											<img
												src="/images/mawar-kiri.webp"
												alt=""
												aria-hidden="true"
												width="900"
												height="700"
												class="absolute inset-0 h-full w-full object-cover opacity-20 mix-blend-screen"
											/>
										</>
									)
								}
								<div class="absolute inset-0 bg-gradient-to-t from-sage-900/70 via-sage-900/10 to-transparent"></div>

								<div class="relative flex min-h-[300px] flex-col justify-between p-7 text-white sm:min-h-[360px] lg:min-h-[420px]">
									<div class="flex items-start justify-between gap-3">
										<span class="rounded-full border border-white/25 bg-white/10 px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest backdrop-blur">
											Sagita Wedding Organizer
										</span>
										{isPopular && (
											<span class="rounded-full bg-white px-3 py-1.5 text-[10px] font-bold uppercase tracking-widest text-terracotta-600">
												{t.mostPopular}
											</span>
										)}
									</div>

									<div>
										<p class="text-[11px] font-semibold uppercase tracking-widest text-sage-200">
											{copy.highlights}
										</p>
										<h2 class="font-display mt-2 text-3xl font-semibold leading-tight">
											{pkg.name}
										</h2>
										{startingOption && (
											<div class="mt-5 inline-flex items-center gap-3 rounded-2xl border border-white/15 bg-white/10 px-4 py-3 backdrop-blur">
												<span class="text-[10px] uppercase tracking-widest text-sage-100">
													{copy.startingFrom}
												</span>
												<span class="text-lg font-bold">
													Rp {formatPrice(startingOption.finalPriceValue)}
												</span>
											</div>
										)}
									</div>
								</div>
							</div>
						</div>
						</div>
					</section>

					<section class="package-detail-content">
					<div id="package-options" class="site-container scroll-mt-28">
						<div class="grid gap-8 lg:grid-cols-3">
							<div class="min-w-0 space-y-6 lg:col-span-2">
								<div class="rounded-[24px] border border-stone-200 bg-white p-6 md:p-8">
									<div class="mb-6 flex items-start justify-between gap-4">
										<div>
											<h2
												class="font-display text-2xl font-bold text-sage-900"
											>
												{t.chooseYourOption}
											</h2>
											<p class="mt-1 text-sm text-stone-500">{t.chooseYourOptionDesc}</p>
										</div>
										{options.length > 0 && (
											<span class="hidden shrink-0 rounded-full bg-sage-50 px-3 py-1 text-xs font-semibold text-sage-700 sm:inline-flex">
												{options.length} {copy.items}
											</span>
										)}
									</div>

									{options.length > 0 ? (
										<div
											class:list={[
												"grid gap-3",
												options.length > 1 ? "sm:grid-cols-2" : "",
											]}
										>
											{options.map((option: any) => (
												<div
													class="group relative overflow-hidden rounded-2xl border border-stone-200 bg-stone-50/70 p-5 transition hover:-translate-y-0.5 hover:border-sage-300 hover:bg-white hover:shadow-sm"
												>
													<div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
														<div class="min-w-0">
															<div class="flex items-center gap-2">
																<span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-sage-100 text-sage-700">
																	<Icon name="spark" size="h-4 w-4" />
																</span>
																<h3 class="font-semibold text-sage-900">{option.name}</h3>
															</div>
														</div>

														<div class="sm:text-right">
															{option.discount_price &&
																Number(option.discount_price) < Number(option.price) && (
																	<p class="text-xs text-stone-400 line-through">
																		Rp {formatPrice(option.price)}
																	</p>
																)}
															<p class="text-xl font-bold text-sage-700">
																Rp {formatPrice(option.final_price ?? option.price)}
															</p>
														</div>
													</div>
												</div>
											))}
										</div>
									) : (
										<p class="text-sm text-stone-500">{t.packageNotFoundDesc}</p>
									)}
								</div>

								{features.length > 0 && (
									<div class="rounded-[24px] border border-stone-200 bg-white p-6 md:p-8">
										<div class="flex items-start justify-between gap-4">
											<h2
												class="font-display text-2xl font-bold text-sage-900"
											>
												{t.whatsIncluded}
											</h2>
											{totalFeatures > 0 && (
												<span class="shrink-0 rounded-full bg-terracotta-50 px-3 py-1 text-xs font-semibold text-terracotta-700">
													{totalFeatures} {copy.items}
												</span>
											)}
										</div>

										<div
											class:list={[
												"mt-6 grid gap-4",
												featureGroups.length > 1 ? "xl:grid-cols-2" : "",
											]}
										>
											{featureGroups.map((group) => (
												<section class="rounded-2xl border border-stone-200 bg-stone-50/60 p-5">
													<div class="flex items-center gap-2">
														<span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-sage-100 text-sage-700">
															<Icon name="check" size="h-4 w-4" />
														</span>
														<h3 class="text-sm font-bold uppercase tracking-wide text-sage-800">
															{group.category || copy.highlights}
														</h3>
													</div>
													<ul class="mt-4 grid list-none grid-cols-1 gap-x-8 gap-y-4 sm:grid-cols-2">
														{group.items.map((feature) => (
															<li class="flex items-start gap-3 text-sm text-stone-warm">
																<span aria-hidden="true" class="mt-0.5 shrink-0 text-sage-700">
																	<svg
																		xmlns="http://www.w3.org/2000/svg"
																		width="18"
																		height="18"
																		viewBox="0 0 24 24"
																		fill="none"
																		stroke="currentColor"
																		stroke-width="2.5"
																		stroke-linecap="round"
																		stroke-linejoin="round"
																	>
																		<polyline points="20 6 9 17 4 12"></polyline>
																	</svg>
																</span>
																<span>{feature}</span>
															</li>
														))}
													</ul>
												</section>
											))}
										</div>
									</div>
								)}

								{(Number(pkg.lead_time_days) > 0 || blackoutDates.length > 0) && (
									<div class="rounded-[24px] border border-stone-200 bg-white p-6 md:p-8">
										<div class="flex items-center gap-2">
											<span class="grid h-8 w-8 place-items-center rounded-full bg-sage-100 text-sage-700">
												<Icon name="clock" size="h-4 w-4" />
											</span>
											<h2 class="font-display text-xl font-bold text-sage-900">
												{t.leadTime}
											</h2>
										</div>

										{Number(pkg.lead_time_days) > 0 && (
											<p class="mt-4 text-sm text-stone-warm">
												{pkg.lead_time_days} {t.leadTimeDays}
											</p>
										)}

										{blackoutDates.length > 0 && (
											<>
												<h3 class="mt-5 text-xs font-bold uppercase tracking-wide text-stone-400">
													{t.blackoutDates}
												</h3>
												<div class="mt-2 flex flex-wrap gap-2">
													{blackoutDates.map((item: any) => (
														<span class="rounded-full bg-terracotta-50 px-3 py-1 text-xs text-terracotta-700">
															{formatDate(item && item.date)}
															{item && item.reason && <> — {item.reason}</>}
														</span>
													))}
												</div>
											</>
										)}
									</div>
								)}

								<div class="grid gap-6 md:grid-cols-2">
									{addons.length > 0 && (
										<div class="rounded-[24px] border border-stone-200 bg-white p-6">
											<h2 class="font-display text-xl font-bold text-sage-900">
												{t.addonsTitle}
											</h2>

											<div class="mt-5 space-y-4">
												{addons.map((addon: any) => (
													<div class="rounded-2xl border border-stone-200 bg-stone-50 p-4">
														<div class="flex flex-wrap items-start justify-between gap-3">
															<div>
																<h3 class="font-semibold text-sage-900">{addon.name}</h3>
																{addon.description && (
																	<p class="mt-1 text-xs text-stone-500">{addon.description}</p>
																)}
																{addon.requires_addon_uuid && addonNames.get(addon.requires_addon_uuid) && (
																	<p class="mt-1 text-xs text-terracotta-700">
																		<i class="bi bi-link-45deg me-1"></i>
																		{addonNames.get(addon.requires_addon_uuid)}
																	</p>
																)}
															</div>
															<p class="font-bold text-sage-700">
																Rp {formatPrice(addon.final_price ?? addon.price)}
															</p>
														</div>
														<p class="mt-2 text-[11px] uppercase tracking-wide text-stone-400">
															{t.minQuantity} {addon.min_quantity ?? 1} · {t.maxQuantity}{" "}
															{addon.max_quantity ?? 99}
														</p>
													</div>
												))}
											</div>
										</div>
									)}

									{promos.length > 0 && (
										<div class="rounded-[24px] border border-stone-200 bg-white p-6">
											<h2 class="font-display text-xl font-bold text-sage-900">
												{t.activePromos}
											</h2>

											<div class="mt-4 flex flex-wrap gap-2">
												{promos.map((promo: any) => (
													<span class="rounded-full bg-sage-50 px-3 py-1 text-xs font-semibold text-sage-800">
														{promo.code} · {promoLabel(promo)}
													</span>
												))}
											</div>
										</div>
									)}
								</div>
							</div>

							<aside class="min-w-0">
								<div
									class="package-detail-booking-card overflow-hidden rounded-[28px] lg:sticky lg:top-28"
								>
									<div class="package-detail-booking-card__header relative isolate px-7 pt-7 pb-6">
										<div class="absolute -top-16 -right-16 h-40 w-40 rounded-full bg-terracotta-400/30 blur-3xl" aria-hidden="true"></div>
										<p class="relative text-[10px] font-bold uppercase tracking-widest text-sage-700">
											Sagita Wedding Organizer
										</p>
										<h2 class="font-display relative mt-2 text-2xl font-bold text-sage-900">
											{pkg.name}
										</h2>
										{startingOption && (
											<div class="package-detail-booking-card__price relative mt-5 rounded-2xl p-4">
												<p class="text-[10px] uppercase tracking-widest text-stone-500">
													{copy.startingFrom}
												</p>
												<p class="mt-1 text-2xl font-bold text-sage-900">
													Rp {formatPrice(startingOption.finalPriceValue)}
												</p>
											</div>
										)}
									</div>

									<div class="border-t border-stone-100 px-7 py-6">
										<p class="text-sm leading-relaxed text-stone-600">
											{t.chooseYourPackageDesc}
										</p>

										<ul class="mt-5 space-y-3 text-sm text-stone-600">
											{totalFeatures > 0 && (
												<li class="flex items-start gap-2.5">
													<Icon name="check" size="mt-0.5 h-4 w-4 shrink-0" />
													{totalFeatures} {copy.items} {t.whatsIncluded}
												</li>
											)}
											{Number(pkg.lead_time_days) > 0 && (
												<li class="flex items-start gap-2.5">
													<Icon name="clock" size="mt-0.5 h-4 w-4 shrink-0" />
													{pkg.lead_time_days} {t.leadTimeDays}
												</li>
											)}
											{addons.length > 0 && (
												<li class="flex items-start gap-2.5">
													<Icon name="spark" size="mt-0.5 h-4 w-4 shrink-0" />
													{addons.length} {t.addonsTitle}
												</li>
											)}
											{promos.length > 0 && (
												<li class="flex items-start gap-2.5">
													<Icon name="shield" size="mt-0.5 h-4 w-4 shrink-0" />
													{promos.length} {copy.promo}
												</li>
											)}
										</ul>

										<button
											type="button"
											data-action="open-booking"
											data-package-uuid={pkg.uuid}
											data-package-slug={pkg.slug}
											class="mt-7 flex w-full items-center justify-center gap-2 rounded-full bg-sage-700 px-5 py-3.5 text-sm font-semibold text-white transition hover:bg-sage-800"
										>
											{t.chooseYourPackage}
											<Icon name="arrow" size="h-4 w-4" />
										</button>

										<a
											href={contactLinks.whatsappLink}
											target="_blank"
											rel="noopener noreferrer"
											class="mt-3 flex w-full items-center justify-center gap-2 rounded-full border border-sage-200 px-5 py-3 text-sm font-semibold text-sage-700 transition hover:bg-sage-50"
										>
											<Icon name="whatsapp" size="h-4 w-4" />
											{t.ctaHelpBtn}
										</a>
									</div>
								</div>
							</aside>
						</div>
					</div>
					</section>
				</>
			) : (
				<section class="site-container site-page-content py-20 text-center">
					<div class="text-6xl">📦</div>
					<h1 class="font-display mt-4 text-3xl font-bold text-sage-900">
						{t.packageNotFoundTitle}
					</h1>
					<p class="text-stone-warm mt-2">{error || t.packageNotFoundDesc}</p>
					<a href="/packages" class="mt-6 inline-block rounded-full bg-sage-700 px-7 py-3 font-semibold text-white">
						{t.packagesTitleA} →
					</a>
				</section>
			)
		}
	</main>
</BaseLayout>
