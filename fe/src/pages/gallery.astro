---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPageBatch } from "../lib/services/batchService.js";

const { lang, t } = Astro.locals;
const isID = lang === "id";
const data = await getPageBatch("gallery").catch(() => null);
const gallery = Array.isArray(data?.gallery) ? data.gallery : [];
---

<BaseLayout
	title={isID
		? "Galeri Pernikahan | Sagita Wedding Planner"
		: "Wedding Gallery | Sagita Wedding Planner"}
	metaDescription={isID
		? "Lihat galeri Sagita Wedding Planner untuk inspirasi suasana dan detail perayaan pernikahan."
		: "Explore the Sagita Wedding Planner gallery for inspiration from wedding celebrations and thoughtful details."}
>
	<main class="antialiased">
		<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-20">
			<h1 class="font-display text-4xl font-bold">Dipercaya para artis di hari spesialnya</h1>
			<p class="text-stone-warm mt-2">{t.galleryDesc}</p>
			<div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
				{
					gallery.map((img: any, i: number) => (
						<img
							data-gallery
							data-action="open-lightbox"
							data-lightbox-index={i}
							data-remove-on-error
							src={img.gambar}
							alt={img.nama || "Our Gallery"}
							width="480"
							height="200"
							fetchpriority={i === 0 ? "high" : undefined}
							loading={i === 0 ? undefined : "lazy"}
							decoding="async"
							class="h-[200px] w-full object-cover rounded-[20px] cursor-pointer hover:opacity-90 transition"
						/>
					))
				}
			</div>
		</section>

		<div id="lightbox" class="fixed inset-0 z-[70] hidden bg-black/80 backdrop-blur-sm grid place-items-center p-4">
			<button type="button" data-action="close-lightbox" class="absolute top-6 right-6 w-10 h-10 rounded-full bg-white/20 text-white grid place-items-center text-xl">✕</button>
			<button type="button" data-action="lightbox-nav" data-dir="-1" class="absolute left-6 w-10 h-10 rounded-full bg-white grid place-items-center">‹</button>
			<img alt="" class="max-h-[80vh] max-w-[90vw] rounded-2xl object-contain" />
			<button type="button" data-action="lightbox-nav" data-dir="1" class="absolute right-6 w-10 h-10 rounded-full bg-white grid place-items-center">›</button>
		</div>
	</main>
</BaseLayout>

<script>
	import "../lib/browser/pages/gallery";
</script>
