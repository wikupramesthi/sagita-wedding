---
const { lang, site, nonce } = Astro.locals;
const copy =
	lang === "id"
		? {
				label: "Persetujuan analitik",
				text: "Kami menggunakan analitik untuk memahami kunjungan. Pilih terima atau tolak.",
				accept: "Terima",
				decline: "Tolak",
			}
		: {
				label: "Analytics consent",
				text: "We use analytics to understand visits. Choose accept or decline.",
				accept: "Accept",
				decline: "Decline",
			};
const gaId = JSON.stringify(site.gaId || "").replace(/</g, "\\u003c");
const scriptNonce = JSON.stringify(nonce).replace(/</g, "\\u003c");
const consentScript = `(function () {
	var KEY = "sagita_analytics";
	var GA_ID = ${gaId};
	var banner = document.getElementById("analytics-consent");
	function value() {
		return document.cookie.split("; ").reduce(function (found, entry) {
			return entry.indexOf(KEY + "=") === 0 ? entry.slice(KEY.length + 1) : found;
		}, "");
	}
	function remember(next) {
		var secure = location.protocol === "https:" ? "; Secure" : "";
		document.cookie = KEY + "=" + next + "; Max-Age=31536000; Path=/; SameSite=Lax" + secure;
	}
	function load() {
		if (!GA_ID || window.__sagitaAnalyticsLoaded) return;
		window.__sagitaAnalyticsLoaded = true;
		window.dataLayer = window.dataLayer || [];
		function gtag() { window.dataLayer.push(arguments); }
		window.gtag = gtag;
		gtag("js", new Date());
		gtag("config", GA_ID);
		var script = document.createElement("script");
		script.async = true;
		script.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(GA_ID);
		script.nonce = ${scriptNonce};
		document.head.appendChild(script);
	}
	var choice = value();
	if (choice === "granted") load();
	else if (!choice && banner) banner.classList.remove("hidden");
	if (banner) {
		banner.addEventListener("click", function (event) {
			var button = event.target.closest("[data-analytics-consent]");
			if (!button) return;
			var next = button.getAttribute("data-analytics-consent");
			remember(next);
			banner.classList.add("hidden");
			if (next === "granted") load();
		});
	}
})();`;
---

{site.gaId && (
	<>
		<div
			id="analytics-consent"
			role="region"
			aria-label={copy.label}
			class="fixed bottom-4 left-1/2 z-[70] hidden w-[calc(100%-2rem)] max-w-lg -translate-x-1/2 rounded-2xl border border-stone-200 bg-white p-4 shadow-xl"
		>
			<p class="text-sm text-stone-warm">{copy.text}</p>
			<div class="mt-3 flex flex-wrap gap-2">
				<button
					type="button"
					data-analytics-consent="granted"
					class="rounded-full bg-sage-700 px-5 py-2 text-sm font-semibold text-white transition hover:bg-sage-900"
				>
					{copy.accept}
				</button>
				<button
					type="button"
					data-analytics-consent="denied"
					class="rounded-full border border-stone-200 px-5 py-2 text-sm font-semibold text-sage-900 transition hover:border-sage-700"
				>
					{copy.decline}
				</button>
			</div>
		</div>
		<script is:inline nonce={nonce} set:html={consentScript}></script>
	</>
)}
