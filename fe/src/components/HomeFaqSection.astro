---
import type { HomeFaqGroup } from "../lib/data/faqContent.js";

interface Props {
	sectionId: string;
	groups: HomeFaqGroup[];
	eyebrow: string;
	expandAll: string;
	collapseAll: string;
	stillTitle: string;
	stillDesc: string;
	stillButton: string;
	viewAll: string;
	whatsappHref: string;
}

const {
	sectionId,
	groups,
	eyebrow,
	expandAll,
	collapseAll,
	stillTitle,
	stillDesc,
	stillButton,
	viewAll,
	whatsappHref,
} = Astro.props;
---

<section id={sectionId} data-home-faq-section class="home-faq-section py-20 sm:py-24">
	<div class="site-container">
		<div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
			<div class="reveal self-start lg:sticky lg:top-24">
				<div class="border-t border-sand-200" role="group" aria-label={eyebrow}>
					{
						groups.map((group, i) => (
							<button
								type="button"
								class="home-faq-tab group flex w-full items-center justify-between border-b border-sand-200 py-3.5 text-left text-sm font-medium text-sage-900 transition-colors duration-200 hover:text-terracotta-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-sage-500/30 sm:text-base"
								data-home-faq-tab={group.id}
								aria-controls={`${sectionId}-group-${group.id}`}
								aria-pressed={i === 0 ? "true" : "false"}
							>
								<span>{group.kategori}</span>
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="text-sand-500 transition-transform group-hover:translate-x-1" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
							</button>
						))
					}
				</div>
				<div class="mt-7 flex items-center gap-4 text-sm text-sand-600">
					<button
						type="button"
						data-home-faq-expand
						class="font-medium underline-offset-4 hover:text-sage-900 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-500/30"
					>
						{expandAll}
					</button>
					<span aria-hidden="true">·</span>
					<button
						type="button"
						data-home-faq-collapse
						class="font-medium underline-offset-4 hover:text-sage-900 hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-sage-500/30"
					>
						{collapseAll}
					</button>
				</div>
				<div class="mt-10">
					<h3 class="font-display text-xl text-sage-900">{stillTitle}</h3>
					<p class="mt-2 max-w-md text-sm leading-relaxed text-stone-warm">{stillDesc}</p>
					<div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
						<a
							href={whatsappHref}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 rounded-full border border-sand-300 px-5 py-3 text-sm font-semibold text-sage-900 transition-colors hover:border-sage-700 hover:bg-white"
						>
							{stillButton}
							<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
						</a>
						<a href="/faq" class="text-sm font-medium text-sage-700 underline-offset-4 hover:text-sage-900 hover:underline">
							{viewAll}
						</a>
					</div>
				</div>
			</div>

			<div class="reveal min-w-0">
				<div id={`${sectionId}Groups`} class="space-y-8">
					{
						groups.map((group, groupIndex) => (
							<section
								id={`${sectionId}-group-${group.id}`}
								class="home-faq-group reveal scroll-mt-28"
								data-delay={groupIndex * 90}
								data-home-faq-group={group.id}
							>
								<h3 class="mb-3 font-semibold text-sm text-sage-700 sm:text-base">{group.kategori}</h3>
								<div class="border-t border-sand-200">
									{
										group.items.map((item, itemIndex) => {
											const isFirst = groupIndex === 0 && itemIndex === 0;
											const buttonId = `${sectionId}-question-${group.id}-${item.id}`;
											const panelId = `${sectionId}-answer-${group.id}-${item.id}`;
											return (
												<article
													class:list={[
														"home-faq-item border-b border-sand-200",
														isFirst ? "is-open" : "",
													]}
													data-home-faq-item
												>
													<button
														type="button"
														id={buttonId}
														data-home-faq-button
														class="flex w-full items-start gap-4 py-4 text-left focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-sage-500/30 sm:py-5"
														aria-expanded={isFirst ? "true" : "false"}
														aria-controls={panelId}
													>
														<span class="min-w-0 flex-1 font-semibold text-base leading-snug text-sage-900 sm:text-lg">
															{item.question}
														</span>
														<span class="home-faq-toggle ms-auto grid h-6 w-6 shrink-0 place-items-center text-xl leading-none text-sage-600 transition-colors">
															{isFirst ? "×" : "+"}
														</span>
													</button>
													<div
														id={panelId}
														data-home-faq-panel
														role="region"
														aria-labelledby={buttonId}
														aria-hidden={isFirst ? "false" : "true"}
														class:list={[
															"home-faq-panel",
															isFirst ? "is-open" : "",
														]}
													>
														<div class="home-faq-panel-inner">
															<div class="max-w-3xl pb-5 text-sm leading-relaxed text-stone-warm whitespace-pre-line sm:text-base">
																{item.answer}
															</div>
														</div>
													</div>
												</article>
											);
										})
									}
								</div>
							</section>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>
