---
const { t } = Astro.locals;
const a = t.accessibility;
---

<div id="accessibilityWidget" class="accessibility-widget">
	<section
		id="accessibilityPanel"
		class="accessibility-panel"
		role="region"
		aria-labelledby="accessibilityTitle"
		hidden
	>
		<div class="accessibility-panel-header">
			<div>
				<h2 id="accessibilityTitle">{a.title}</h2>
				<p>{a.subtitle}</p>
			</div>
			<button
				type="button"
				class="accessibility-close"
				data-a11y-close
				aria-label={a.close}
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="18"
					height="18"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					aria-hidden="true"><path d="m18 6-12 12M6 6l12 12"></path></svg
				>
			</button>
		</div>

		<div class="accessibility-text-size">
			<span class="accessibility-label">{a.textSize}</span>
			<div class="accessibility-size-controls" role="group" aria-label={a.textSize}>
				<button type="button" data-a11y-size="down" aria-label={a.decrease}>A−</button>
				<button
					type="button"
					data-a11y-size="reset"
					data-a11y-size-value
					data-standard={a.standard}
					aria-label={a.reset}>{a.standard}</button
				>
				<button type="button" data-a11y-size="up" aria-label={a.increase}>A+</button>
			</div>
		</div>

		<div class="accessibility-options">
			<button
				type="button"
				class="accessibility-option"
				data-a11y-toggle="contrast"
				aria-pressed="false"
			>
				<span class="accessibility-option-icon" aria-hidden="true">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"><circle cx="12" cy="12" r="9"></circle><path d="M12 3a9 9 0 0 0 0 18Z"></path></svg
					>
				</span>
				<span>{a.contrast}</span>
				<span class="accessibility-switch" aria-hidden="true"></span>
			</button>
			<button
				type="button"
				class="accessibility-option"
				data-a11y-toggle="grayscale"
				aria-pressed="false"
			>
				<span class="accessibility-option-icon" aria-hidden="true">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"><path d="M12 3a9 9 0 1 0 0 18V3Z"></path><path d="M12 3a9 9 0 0 1 0 18M12 7v10"></path></svg
					>
				</span>
				<span>{a.grayscale}</span>
				<span class="accessibility-switch" aria-hidden="true"></span>
			</button>
			<button
				type="button"
				class="accessibility-option"
				data-a11y-toggle="underline"
				aria-pressed="false"
			>
				<span class="accessibility-option-icon" aria-hidden="true">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"><path d="M5 4v7a7 7 0 0 0 14 0V4M4 21h16"></path></svg
					>
				</span>
				<span>{a.underline}</span>
				<span class="accessibility-switch" aria-hidden="true"></span>
			</button>
			<button
				type="button"
				class="accessibility-option"
				data-a11y-toggle="motion"
				aria-pressed="false"
			>
				<span class="accessibility-option-icon" aria-hidden="true">
					<svg
						xmlns="http://www.w3.org/2000/svg"
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.7"
						><path d="M4 12h16M4 6h10M4 18h7"></path><path d="m18 4 2 2-2 2"></path></svg
					>
				</span>
				<span>{a.motion}</span>
				<span class="accessibility-switch" aria-hidden="true"></span>
			</button>
		</div>

		<button type="button" class="accessibility-reset" data-a11y-reset>
			{a.resetAll}
		</button>
	</section>

	<button
		type="button"
		id="accessibilityTrigger"
		class="accessibility-trigger"
		aria-controls="accessibilityPanel"
		aria-expanded="false"
		aria-label={a.open}
		title={a.open}
	>
		<svg
			xmlns="http://www.w3.org/2000/svg"
			width="25"
			height="25"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="1.65"
			aria-hidden="true"
			><circle cx="12" cy="12" r="9.25"></circle><circle
				cx="12"
				cy="7.5"
				r="1.25"
				fill="currentColor"
				stroke="none"></circle><path d="M5.5 10.25h13M12 9.5v9M9 20l3-5 3 5M8.25 11.5l-1.5 4M15.75 11.5l1.5 4"></path></svg
		>
		<span class="accessibility-trigger-label">{a.title}</span>
	</button>
</div>
