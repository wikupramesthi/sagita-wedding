{
	"extends": "astro/tsconfigs/strict",
	"compilerOptions": {
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"types": ["astro/client", "node", "vitest/globals"],
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"]
		}
	},
	"include": [
		".astro/types.d.ts",
		"src/**/*",
		"scripts/**/*",
		"tests/**/*",
		"astro.config.mjs"
	],
	"exclude": ["dist", "node_modules", "public/js"]
}
