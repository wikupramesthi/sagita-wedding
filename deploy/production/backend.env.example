APP_NAME="Sagita Wedding"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://app.example.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sagita
DB_USERNAME=sagita_app
DB_PASSWORD=CHANGE_ME_USE_A_UNIQUE_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=.example.com
SESSION_COOKIE=sagita_session
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=website@example.com
MAIL_FROM_NAME="${APP_NAME}"

FRONTEND_URL=https://example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://app.example.com/auth/google/callback

CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
FRONTEND_API_KEY=CHANGE_ME_COPY_THE_SAME_VALUE_TO_FE_API_KEY
FRONTEND_API_KEYS=

NOCAPTCHA_SITEKEY=
NOCAPTCHA_SECRET=

MANUAL_BANK_NAME=
MANUAL_BANK_ACCOUNT=
MANUAL_BANK_HOLDER=
MANUAL_ADMIN_WA=
MANUAL_PROOF_MAX_KB=3072
MANUAL_PROOF_DISK=local
MANUAL_PROOF_DIR=proofs

WHATSAPP_ENABLED=false
WHATSAPP_DRIVER=log
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_FROM=
